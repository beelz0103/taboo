  sureYes:"YES — THEY SAID IT", sureNo:"never mind",
  joinBtn:"JOIN FROM MY PHONE", joinTitle:"JOIN", joinGo:"JOIN",
  joinHint:"For when everyone plays on their own phone. Take the room code<br>from the host's screen and put your name in.",
  joinNamePh:"Your name", joinRoomPh:"Room code",
  joinWait:"waiting for the host…", joinNone:"No game answered — check the room code.",
  rejoining:"getting you back into the game…",
  lobbyTitle:"LOBBY", lobbyWait:"waiting for the host to start…", leaveGame:"LEAVE",
  youTag:"YOU", afkTag:"away", afkToggle:"mark away / back", afkBtn:"AFK", meBtn:"ME",
  afkHint:"💤 marks someone away and their turn gets skipped. Anyone can toggle it.",
  waitingFor:n=>`waiting for ${n} to start…`,
  skipPlayer:"SKIP THIS PLAYER",
  guessNow:"GUESS!", guessWho:(d,j)=>`<b>${d}</b> is describing<br>${j} is judging<br>no peeking at the card`,
  roleDesc:"YOU DESCRIBE", roleGuess:"YOU GUESS", roleWatch:"YOU WATCH THEM",
  roleWatchNote:"Buzz a banned word. Hit CORRECT when they get it.",
  netRoom:"ROOM", copyLink:"copy link", copied:"copied",
  netOffline:"no server · this browser only",
  netWait:"connecting…",
  netLive:n=>`${n} screen${n===1?"":"s"} linked`,
  netHelp:(u,c)=>`Open <b>${u}</b> on the other phone and enter room code <b>${c}</b> — its judge, buzzer and scorekeeper screens then follow this game.`,
  cats:{"食べ物":"FOOD","生き物":"ANIMALS","もの":"THINGS","場所":"PLACES","行事":"EVENTS","すること":"ACTIONS","名所":"LANDMARKS","有名人":"PEOPLE","キャラ":"CHARACTERS","スポーツ":"SPORTS","ブランド":"BRANDS","考えかた":"IDEAS","社会":"SOCIETY","ネット":"INTERNET","ことわざ":"SAYINGS"},
  lvlName:{1:"EASY",2:"MEDIUM",3:"HARD"}
}
};

const $ = id => document.getElementById(id);
const esc = s => String(s==null?"":s).replace(/[&<>"']/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const gateEl=$("gate"), menuEl=$("menu"), setupEl=$("setup"), readyEl=$("ready"), rulesEl=$("rules"),
      playEl=$("play"), endEl=$("end"), finalEl=$("final"), joinEl=$("join"), lobbyEl=$("lobby"),
      setEl=$("settings"),
      buzzEl=$("buzzer"), judgeEl=$("judge"), keepEl=$("keeper");
const SCREENS=[gateEl,menuEl,setupEl,readyEl,rulesEl,playEl,endEl,finalEl,joinEl,lobbyEl,setEl,buzzEl,judgeEl,keepEl];
const COMPANIONS=[buzzEl,judgeEl,keepEl];
const SKINS=["classic","neon","poison","midnight","washi"];
const PER_CARD = 4;                  /* 2 words per face x 2 faces */

let DECK = DECK_JA;
let lang="ja", T=I18N.ja;            /* interface language */
let deckLang="ja";                   /* language the game is played in */
let skin="classic", mode="quick", langLocked=false;
let level=0, limit=60, picked=false;
let left=60, score=0, passes=0, fouls=0, missed=[], sound=true, timer=null;
let pool=[], queue=[], hand=null, slot=0, cardNo=0, current=null;

/* the table: seats in order, 1 2 1 2 ... — your number is your team */
const S = {
  seats:[], tnames:["",""],
  turnIdx:0, judgePick:null,
  laps:2, lap:1, scores:[0,0], stats:{}, active:false
};
/* who this device is: null = a shared screen that sees everything (pass-the-phone) */
let isHost=false, me=null, following=false;

const teamOf   = i => i % 2;
const seatName = i => (S.seats[i] && S.seats[i].name) || "";
const away     = p => !!(p && (p.afk || p.gone));
/* the judge is the next seat along that is actually present */
const judgeIdx = () => {
  if(S.judgePick!=null) return S.judgePick;
  const n=S.seats.length;
  if(n<2) return S.turnIdx;
  for(let k=1;k<n;k++){ const i=(S.turnIdx+k)%n; if(!away(S.seats[i])) return i; }
  return (S.turnIdx+1)%n;
};
const teamName = t => (S.tnames[t] || "").trim() || T.teamNum(t+1);

/* ---------- persistence (this device only) ---------- */
function save(){
  try{
    localStorage.setItem("taboo", JSON.stringify({
      skin, sound, lang, deckLang, level, limit, picked, mode,
      room: Net.room,
      role: isHost ? "host" : (following ? "player" : null),
      me: me ? {name:me.name, seat:me.seat} : null,
      S:{seats:S.seats, tnames:S.tnames, turnIdx:S.turnIdx, laps:S.laps, lap:S.lap,
         scores:S.scores, stats:S.stats, active:S.active},
      sk:{a:sk.a, b:sk.b, na:$("skNameA").value, nb:$("skNameB").value}
    }));
  }catch(e){}
}
function load(){ try{ return JSON.parse(localStorage.getItem("taboo")) || {}; }catch(e){ return {}; } }

/* ---------- theme ---------- */
function applySkin(){
  document.documentElement.setAttribute("data-skin", skin);
  document.querySelectorAll("#segSkin button").forEach(b=>b.setAttribute("aria-pressed", String(b.dataset.v===skin)));
  const m = document.querySelector('meta[name="theme-color"]');
  if(m) m.setAttribute("content", getComputedStyle(document.documentElement).getPropertyValue("--ground").trim() || "#D40D2A");
  save();
}

/* ---------- interface language ---------- */
function applyLang(){
  T = I18N[lang];
  document.documentElement.lang = lang;
  document.querySelectorAll("[data-t]").forEach(el=>{
    const v = T[el.dataset.t];
    if(typeof v === "string") el.innerHTML = v;
  });
  document.querySelectorAll("[data-ph]").forEach(el=>{
    const v = T[el.dataset.ph];
    if(typeof v === "string") el.placeholder = v;
  });
  $("buzzFace").setAttribute("data-buzz", T.buzzFace);
  $("jgBuzzFace").setAttribute("data-buzz", T.buzzFace);
  $("bzFace").textContent = T.buzzFace;
  $("steps").innerHTML = T.steps.map(s=>`<li><span>${s}</span></li>`).join("");
  $("scoring").innerHTML = T.scoring.map(([k,v])=>`<div>${k}<span>${v}</span></div>`).join("");
  $("soundBtn").textContent = sound ? T.soundOn : T.soundOff;
  document.querySelectorAll(".lang button").forEach(b=>b.setAttribute("aria-pressed", String(b.dataset.lang===lang)));
  document.querySelectorAll("#segUi button").forEach(b=>b.setAttribute("aria-pressed", String(b.dataset.v===lang)));
  $("tName0").placeholder = T.teamNum(1);
  $("tName1").placeholder = T.teamNum(2);
  if(!$("skNameA").value) $("skNameA").value = T.teamA;
  if(!$("skNameB").value) $("skNameB").value = T.teamB;
  if(!$("againBtn").textContent) $("againBtn").textContent = T.again;
  renderSeats(); updateCount(); syncLabel(); renderLive();
  if(!readyEl.hidden) paintReady();
  if(hand) paint();
  save();
}
document.querySelector(".lang").addEventListener("click", e=>{
  const b = e.target.closest("button[data-lang]"); if(!b) return;
  lang = b.dataset.lang; langLocked=true; applyLang();
});

/* ---------- card language ---------- */
function applyDeck(){
  DECK = deckLang === "en" ? DECK_EN : DECK_JA;
  document.querySelectorAll("#segDeck button").forEach(b=>b.setAttribute("aria-pressed", String(b.dataset.v===deckLang)));
  updateCount();
  if(!playEl.hidden){ queue = newQueue(); deal(); }
  save();
}

/* ---------- options ---------- */
function seg(id, fn){
  $(id).addEventListener("click", e=>{
    const b = e.target.closest("button[data-v]"); if(!b) return;
    [...$(id).children].forEach(x=>x.setAttribute("aria-pressed", String(x===b)));
    fn(b.dataset.v);
  });
}
seg("segLevel", v=>{ level=Number(v); updateCount(); save(); });
seg("segTime",  v=>{ limit=Number(v); save(); });
seg("segDeck",  v=>{ deckLang=v; applyDeck(); });
seg("segSkin",  v=>{ skin=v; applySkin(); });
seg("segUi",    v=>{ lang=v; langLocked=true; applyLang(); });
seg("segLaps",  v=>{ S.laps=Number(v); save(); });

function buildPool(){ pool = level ? DECK.filter(c=>c.d===level) : DECK.slice(); }
function updateCount(){
  buildPool();
  $("deckCount").textContent = T.countFmt(Math.floor(pool.length/PER_CARD), pool.length);
}

/* ---------- sound ---------- */
let ac=null;
function tone(freqs, dur, type, vol){
  if(!sound) return;
  try{
    ac = ac || new (window.AudioContext||window.webkitAudioContext)();
    if(ac.state === "suspended") ac.resume();
    const g = ac.createGain();
    g.gain.setValueAtTime(vol, ac.currentTime);
    g.gain.exponentialRampToValueAtTime(.0001, ac.currentTime+dur);
    g.connect(ac.destination);
    freqs.forEach(f=>{
      const o = ac.createOscillator();
      o.type = type; o.frequency.setValueAtTime(f, ac.currentTime);
      o.connect(g); o.start(); o.stop(ac.currentTime+dur);
    });
  }catch(e){}
}
const sBuzz = ()=>tone([150,98], .45, "square", .18);
const sOk   = ()=>tone([880,1320], .1, "triangle", .12);
const sEnd  = ()=>tone([130,86], .9, "sawtooth", .2);
$("soundBtn").onclick = ()=>{ sound=!sound; $("soundBtn").textContent = sound?T.soundOn:T.soundOff; save(); };
function flash(){ const f=$("flash"); f.classList.remove("on"); void f.offsetWidth; f.classList.add("on"); }
function buzzFeedback(){
  sBuzz(); flash();
  if(navigator.vibrate) try{ navigator.vibrate([90,45,150]); }catch(e){}
}

/* ---------- cards: four words each ---------- */
function shuffle(a){
  const c=a.slice();
  for(let i=c.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[c[i],c[j]]=[c[j],c[i]];}
  return c;
}
function newQueue(){
  const sh = shuffle(pool), out = [];
  for(let i=0;i+PER_CARD<=sh.length;i+=PER_CARD) out.push(sh.slice(i,i+PER_CARD));
  if(!out.length && sh.length) out.push(Array.from({length:PER_CARD},(_,k)=>sh[k%sh.length]));
  return out;
}
function paint(){
  if(!hand) return;
  current = hand[slot];
  const other = hand[slot ^ 1];
  $("reading").textContent  = current.r;
  $("target").textContent   = current.w;
  $("ngList").innerHTML     = current.ng.map(x=>`<li>${esc(x)}</li>`).join("");
  $("reading2").textContent = other.r;
  $("target2").textContent  = other.w;
  $("ngList2").innerHTML    = other.ng.map(x=>`<li>${esc(x)}</li>`).join("");
  $("cardNo").textContent   = "NO." + String(cardNo).padStart(3,"0");
  $("cardMeta").textContent = (slot<2 ? T.faceA : T.faceB) + " · " +
                              (T.cats[current.c] || current.c) + " · " + T.lvlName[current.d];
  $("pips").innerHTML = [0,1,2,3].map(i=>`<i class="${i===slot?"on":""}"></i>`).join("");
  pushState();
}
function animate(a){
  const el = $("card");
  el.classList.remove("deal","spin","flip","shake");
  void el.offsetWidth;
  el.classList.add(a);
}
function deal(anim){
  if(!queue.length) queue = newQueue();
  hand = queue.pop(); slot = 0; cardNo++;
  paint(); animate(anim || "deal");
}
function advance(anim){
  if(!hand) return deal(anim);
  if(slot >= PER_CARD-1) return deal(anim || "deal");
  slot++; paint();
  animate(anim || (slot === 2 ? "flip" : "spin"));
}
/* what your hand does to a real card — no points */
function turn(){ if(!playEl.hidden) advance(); }

/* ---------- the hourglass ---------- */
const HG_H = 24;
function hourglass(frac, low){
  frac = Math.max(0, Math.min(1, frac));
  const top=$("hgTop"), bot=$("hgBot");
  top.setAttribute("y", (32 - HG_H*frac).toFixed(2));
  top.setAttribute("height", (HG_H*frac).toFixed(2));
  bot.setAttribute("y", (60 - HG_H*(1-frac)).toFixed(2));
  bot.setAttribute("height", (HG_H*(1-frac)).toFixed(2));
  $("hgStream").style.opacity = (frac>0 && frac<1) ? "1" : "0";
  $("hg").classList.toggle("low", !!low);
}
function flipHourglass(){
  const rects=[$("hgTop"),$("hgBot")], hg=$("hg");
  rects.forEach(r=>r.style.transition="none");
  hourglass(1,false);
  hg.classList.remove("turned"); hg.getBoundingClientRect(); hg.classList.add("turned");
  requestAnimationFrame(()=>rects.forEach(r=>r.style.transition=""));
}

/* ---------- screens ---------- */
let backTo=null;
function show(sec){
  if(sec===setEl){ const cur=SCREENS.find(x=>!x.hidden); if(cur && cur!==setEl) backTo=cur; }
  SCREENS.forEach(s=>s.hidden = s!==sec);
  $("topbar").hidden = sec===gateEl;
  $("netbar").hidden = (sec===gateEl || sec===playEl || sec===setupEl);
  netUI();
  /* a companion screen must not kill a running turn */
  if(sec!==playEl && !COMPANIONS.includes(sec)) clearInterval(timer);
  if(COMPANIONS.includes(sec)) startPing(); else stopPing();
  renderLive();
  applyRole(LS);
  window.scrollTo(0,0);
  pushState();
}
function parseHash(){
  const m = /^#([a-z]+)(?:[=\/]([A-Za-z0-9]+))?/.exec(location.hash || "");
  return m ? {screen:m[1], room:(m[2]||"").toUpperCase()} : {screen:"", room:""};
}
function route(){
  const h = parseHash();
  if(h.room && h.room !== Net.room) Net.connect(h.room);
  if(h.screen === "join"){ picked=true; openJoin(); return; }
  if(h.screen === "buzzer") show(buzzEl);
  else if(h.screen === "judge") show(judgeEl);
  else if(h.screen === "score") show(keepEl);
  else show(picked ? menuEl : gateEl);
}
function goto(hash, el){
  location.hash = Net.room ? hash + "=" + Net.room : hash;
  if(el.hidden) show(el);
}
window.addEventListener("hashchange", route);
function leaveCompanion(){ if(location.hash) location.hash=""; else route(); }

/* ---------- the table ---------- */
function rosterHTML(editable){
  return S.seats.map((p,i)=>`
    <li class="seat${away(p)?" away":""}">
      <span class="tnum ${i%2?"n2":"n1"}">${i%2+1}</span>
      <span class="snm">${esc(p.name)}${p.id?' <i class="own">●</i>':""}${me&&me.seat===i?' <i class="you">'+T.youTag+'</i>':""}</span>
      <span class="sx">${away(p)?T.afkTag:"#"+(i+1)}</span>
      <button type="button" data-afk="${i}" aria-pressed="${!!p.afk}" title="${T.afkToggle}">${T.afkBtn}</button>
      ${editable?`<button type="button" data-mine="${i}" aria-label="this is me">${T.meBtn}</button>
      <button type="button" data-up="${i}" aria-label="move up"${i===0?" disabled":""}>↑</button>
      <button type="button" data-del="${i}" aria-label="remove">✕</button>`:""}
    </li>`).join("");
}
const teamSize = t => S.seats.filter((p,i)=>teamOf(i)===t).length;
/* Taboo needs a describer AND someone to describe to, on both sides: 2 per team. */
function rosterReady(){ return S.seats.length>=4 && teamSize(0)>=2 && teamSize(1)>=2; }
function renderSeats(){
  const ol=$("seats");
  ol.setAttribute("data-empty", T.noPlayers);
  ol.innerHTML = rosterHTML(true);
  $("lobbyList").setAttribute("data-empty", T.noPlayers);
  $("lobbyList").innerHTML = rosterHTML(false);
  const n=S.seats.length;
  $("setupWarn").textContent =
      n<4 ? T.warnNeed4(n)
    : (teamSize(0)<2 || teamSize(1)<2) ? T.warnTeams
    : (n%2 ? T.warnOdd(n) : T.warnOk(n));
  $("setupGo").disabled = !rosterReady();
  renderRoom();
}
/* what the game master reads out to the table */
function renderRoom(){
  $("rpCode").textContent = Net.room || "----";
  const url = Net.base();
  $("rpUrl").innerHTML = url ? T.roomOpen(url) : "";
  $("rpUrl").hidden = !url;
  $("rpNote").hidden = !!url;
  if(!url) $("rpNote").innerHTML = T.roomNoServer;
  const joined = S.seats.filter(p=>p.id && p.id!==Net.id);
  $("rpJoined").innerHTML = T.joinedCount(joined.length, joined.map(p=>esc(p.name)).join(" · "));
}
function addPlayer(){
  const v = $("pAdd").value.trim();
  if(!v || S.seats.length>=16) return;
  S.seats.push({name:v, id:null, afk:false, gone:false, seen:0});
  $("pAdd").value=""; renderSeats(); save(); pushState();
}
/* anyone may park a player: their turn gets skipped until they are back */
function setAfk(i, on){
  const p=S.seats[i]; if(!p) return;
  p.afk = !!on;
  renderSeats(); if(!readyEl.hidden) paintReady(); save(); pushState();
}
$("pAddBtn").onclick = addPlayer;
$("pAdd").addEventListener("keydown", e=>{ if(e.code==="Enter"){ e.preventDefault(); addPlayer(); } });
function rosterClick(e){
  const del=e.target.closest("[data-del]"), up=e.target.closest("[data-up]"),
        afk=e.target.closest("[data-afk]"), mine=e.target.closest("[data-mine]");
  if(afk){
    const i=Number(afk.dataset.afk);
    if(isHost || !following) setAfk(i, !S.seats[i].afk);
    else post({t:"afk", seat:i, on:!S.seats[i].afk});
    return;
  }
  if(mine){                                  /* "this is me" on the host device */
    const i=Number(mine.dataset.mine);
    me = (me && me.seat===i) ? null : {id:Net.id, name:seatName(i), seat:i};
    if(me && S.seats[i]) S.seats[i].id = Net.id;
    renderSeats(); applyRole(null); save(); pushState();
    return;
  }
  if(del) S.seats.splice(Number(del.dataset.del),1);
  else if(up){ const i=Number(up.dataset.up); if(i>0){ const s=S.seats; [s[i-1],s[i]]=[s[i],s[i-1]]; } }
  else return;
  renderSeats(); save(); pushState();
}
$("seats").addEventListener("click", rosterClick);
$("lobbyList").addEventListener("click", rosterClick);
$("rpNew").onclick = ()=>{
  S.seats = S.seats.filter(p=>!p.id || p.id===Net.id);   /* the joined phones are on the old code */
  Net.connect(newRoom());
  renderSeats(); save();
};
$("rpCopy").onclick = ()=>{
  const link = Net.base() ? Net.base()+"/#join="+Net.room : Net.room;
  const done = ()=>{ $("rpCopy").textContent=T.copied; setTimeout(()=>{ $("rpCopy").textContent=T.newRoom&&T.copyLink; },1400); };
  try{ navigator.clipboard.writeText(link).then(done,done); }catch(e){ done(); }
};
$("tName0").oninput = ()=>{ S.tnames[0]=$("tName0").value; save(); };
$("tName1").oninput = ()=>{ S.tnames[1]=$("tName1").value; save(); };

function boardHTML(hi){
  return [0,1].map(t=>{
    const who = S.seats.filter((_,i)=>teamOf(i)===t)
                       .map(p=>esc(p.name)+(away(p)?" 💤":"")).join(" · ") || "—";
    return `<div class="brow${hi===t?" on":""}">
      <span class="who"><span>${esc(teamName(t))}</span><small>${who}</small></span>
      <b>${S.scores[t]}</b></div>`;
  }).join("");
}
function startSession(){
  if(!rosterReady()) return;
  mode="session"; S.active=true; isHost=true; following=false;
  S.turnIdx=0; S.lap=1; S.scores=[0,0]; S.stats={}; S.judgePick=null;
  gotoReady();
}
function gotoReady(){
  S.judgePick=null; paintReady(); show(readyEl); save();
}
function paintReady(){
  if(!S.seats.length) return;
  const i=S.turnIdx, t=teamOf(i);
  $("rdRound").innerHTML = S.laps ? T.lapOf(S.lap, S.laps) : T.lapEndless(S.lap);
  $("rdTeam").textContent = teamName(t);
  $("rdPlayer").textContent = seatName(i);
  $("rdJudge").textContent = seatName(judgeIdx());
  $("jpick").hidden = true;
  $("rdBoard").innerHTML = boardHTML(t);
  applyRole(null);
}
$("rdJudgeBtn").onclick = ()=>{
  const box=$("jpick");
  box.hidden = !box.hidden;
  if(!box.hidden){
    box.innerHTML = S.seats.map((p,i)=> i===S.turnIdx ? "" :
      `<button type="button" data-j="${i}" aria-pressed="${i===judgeIdx()}">${esc(p.name)}${away(p)?" 💤":""}</button>`).join("");
  }
};
$("jpick").addEventListener("click", e=>{
  const b=e.target.closest("[data-j]"); if(!b) return;
  S.judgePick = Number(b.dataset.j);
  paintReady(); pushState();
});
/* the next seat that is present, and whether we went past the end of the table */
function nextSeat(from){
  const n=S.seats.length;
  for(let k=1;k<=n;k++){
    const j=(from+k)%n;
    if(!away(S.seats[j])) return {seat:j, wrapped:(from+k)>=n};
  }
  return null;                       /* everybody is away */
}
function nextTurn(){
  const nx = nextSeat(S.turnIdx);
  if(!nx) return showFinal();
  if(nx.wrapped) S.lap++;
  S.turnIdx = nx.seat;
  if(S.laps && S.lap > S.laps) return showFinal();
  gotoReady();
}
function sessionDone(){
  if(mode!=="session" || !S.laps) return false;
  const nx = nextSeat(S.turnIdx);
  return !nx || (nx.wrapped && S.lap>=S.laps);
}
function showFinal(){
  const [a,b]=S.scores;
  $("winTeam").textContent = a===b ? T.drawLabel : teamName(a>b?0:1);
  $("winScore").textContent = Math.max(a,b);
  $("finBoard").innerHTML = boardHTML(a===b ? -1 : (a>b?0:1));
  const arr = Object.entries(S.stats).sort((x,y)=>y[1].ok-x[1].ok);
  $("mvp").innerHTML = arr.length
    ? T.mvp(esc(arr[0][0]), arr[0][1].ok) + "<br>" + arr.map(([n,s])=>`${esc(n)} ${s.ok}`).join(" · ")
    : "";
  S.active=false; mode="session";
  show(finalEl); save();
}

/* ---------- a turn ---------- */
function fmt(s){ return Math.floor(s/60)+":"+String(s%60).padStart(2,"0"); }
function tick(){
  left--;
  $("clock").textContent = fmt(Math.max(left,0));
  const low = left<=10;
  $("clock").classList.toggle("low", low);
  hourglass(Math.max(left,0)/limit, low);
  pushState();
  if(left<=0){ sEnd(); finish(); }
}
function start(){
  buildPool();
  queue = newQueue(); hand=null; slot=0; cardNo=0;
  score=0; passes=0; fouls=0; missed=[]; left=limit;
  $("score").textContent=0; $("passes").textContent=0; $("fouls").textContent=0;
  $("clock").textContent = fmt(limit);
  $("clock").classList.remove("low");
  $("nowPlaying").hidden = mode!=="session";
  if(mode==="session"){
    const t=teamOf(S.turnIdx);
    const named = teamName(t) !== T.teamNum(t+1) ? `<span>${esc(teamName(t))}</span>` : "";
    $("nowPlaying").innerHTML =
      `<span class="tag">${T.teamNum(t+1)}</span><b>${esc(seatName(S.turnIdx))}</b>` +
      named + `<span>${T.judgeShort}: ${esc(seatName(judgeIdx()))}</span>`;
  }
  show(playEl); applyRole(null); flipHourglass(); deal();
  clearInterval(timer); timer = setInterval(tick,1000);
}
function finish(){
  clearInterval(timer);
  const pts = score - fouls;
  show(endEl);
  $("finalScore").textContent = pts;
  $("fOk").textContent = score; $("fPass").textContent = passes; $("fBuzz").textContent = fouls;
  if(mode==="session" && S.seats.length){
    const i=S.turnIdx, t=teamOf(i), nm=seatName(i);
    S.scores[t] += pts;
    const st = S.stats[nm] || (S.stats[nm]={ok:0,pass:0,buzz:0,turns:0});
    st.ok+=score; st.pass+=passes; st.buzz+=fouls; st.turns++;
    $("addedTo").hidden=false; $("addedTo").innerHTML = T.addedTo(esc(teamName(t)), pts);
    $("endBoard").hidden=false; $("endBoard").innerHTML = boardHTML(t);
    $("againBtn").textContent = sessionDone() ? T.seeResult : T.nextTurn;
  }else{
    $("addedTo").hidden=true; $("endBoard").hidden=true;
    $("againBtn").textContent = T.again;
    post({t:"round", pts});          /* a standalone scorekeeper can take it */
  }
  const box=$("missed");
  if(missed.length){
    box.hidden=false;
    box.innerHTML = `<b>${T.missedTitle}</b>${missed.map(m=>esc(m.w)).join(lang==="ja"?"、":", ")}`;
  } else box.hidden = true;
  save(); pushState();
}
function registerBuzz(){
  fouls++; missed.push(current); $("fouls").textContent=fouls;
  buzzFeedback(); advance("shake");
}
function scoreOk(){ score++; $("score").textContent=score; sOk(); advance(); }
function scorePass(){ passes++; missed.push(current); $("passes").textContent=passes; advance(); }

/* ---------- roles: each device shows only what its player may see ----------
   me === null  -> a shared screen (pass-the-phone, or a table/judge screen): sees all.
   describer    -> the card, may turn it and pass.
   team-mate    -> NO card. They are the ones guessing.
   opponent     -> the card plus judge powers, so any of them can rule and buzz.  */
function roleOf(seat, turnSeat){
  if(seat==null || seat<0) return "watch";
  if(seat===turnSeat) return "describe";
  return teamOf(seat)===teamOf(turnSeat) ? "guess" : "watch";
}
function applyRole(s){
  const turnSeat = s && s.turnSeat!=null ? s.turnSeat : S.turnIdx;
  const seat = me ? me.seat : null;
  const role = roleOf(seat, turnSeat);
  const solo = !me;                          /* nobody has claimed this screen */
  const desc = role==="describe", guess = role==="guess";
  const judgeSeat = s && s.judgeSeat!=null ? s.judgeSeat : judgeIdx();

  /* the card itself */
  $("deckWrap").hidden = guess;
  $("guessView").hidden = !guess;
  if(guess) $("guessWho").innerHTML = T.guessWho(esc(seatName(turnSeat)), esc(seatName(judgeSeat)));

  /* the describer never marks themselves correct; nobody else may pass for them */
  $("okBtn").hidden   = desc || guess;
  $("buzzBtn").hidden = desc || guess;
  $("passBtn").hidden = !(solo || desc);
  $("turnBtn").hidden = guess;
  $("hint").hidden = guess;              /* no card, no controls, no instructions */

  /* ending a turn, quitting, rematching: only the device that runs the game.
     A guest pressing these would only desync itself. */
  const runs = isHost || !following;
  $("stopBtn").hidden = !runs;
  $("rdQuit").hidden  = !runs;
  $("finAgain").hidden = !runs;
  $("finEdit").hidden  = !runs;
  $("finHome").hidden  = !runs;

  /* the banner tells you what you are for this turn */
  const banner=$("roleBanner");
  if(solo){ banner.hidden=true; }
  else{
    banner.hidden=false;
    banner.classList.toggle("mine", desc);
    banner.innerHTML = desc  ? `<b>${T.roleDesc}</b>`
                    : guess  ? `<b>${T.roleGuess}</b><span>${esc(seatName(turnSeat))}</span>`
                             : `<b>${T.roleWatch}</b><span>${T.roleWatchNote}</span>`;
  }

  /* on the hand-off screen only the describer (or a shared screen) can start */
  const mayStart = solo || desc;
  $("rdGo").hidden = !mayStart;
  $("rdWait").hidden = mayStart;
  if(!mayStart) $("rdWait").textContent = T.waitingFor(seatName(turnSeat));
}

/* ---------- the link: BroadcastChannel, same browser, no server ---------- */
let bc=null, pingTimer=null, lastPong=0, LS=null, lsAt=0, liveTimer=null, LScard=null, LScardAt=0;
const cardFresh = ()=> LScard && (Date.now()-LScardAt) < 5000;
try{ bc = new BroadcastChannel("taboo"); }catch(e){}

/* Two ways out of this window, used together:
   BroadcastChannel reaches other windows of this browser (no server needed),
   Net reaches other devices through the relay in server.js when one is running.
   Every message carries an id so a peer on both paths only acts on it once. */
const ROOM_ALPHABET = "ACDEFGHJKLMNPQRSTUVWXYZ23456789";
const seen = new Set();
let mseq = 0;
const Net = {
  id: Math.random().toString(36).slice(2,10),
  room: "", es: null, peers: 0, ready: false,
  key: "",
  base(){ return (location.origin && /^https?:/.test(location.origin)) ? location.origin : ""; },
  usable(){ return !!this.base() && typeof EventSource !== "undefined"; },
  connect(code){
    code = String(code||"").toUpperCase().replace(/[^A-Z0-9]/g,"").slice(0,8);
    if(this.es){ try{ this.es.close(); }catch(e){} this.es=null; }
    this.room = code; this.ready=false; this.peers=0;
    try{ localStorage.setItem("taboo.room", code); }catch(e){}
    if($("roomIn").value !== code) $("roomIn").value = code;
    if(!code || !this.usable()){ netUI(); return; }
    try{
      const es = new EventSource(this.base()+"/events?room="+encodeURIComponent(code)+"&id="+this.id);
      this.es = es;
      es.onopen = ()=>{ this.ready=true; netUI(); post({t:"ping"}); };
      es.onerror = ()=>{ this.ready=false; netUI(); };
      es.onmessage = e=>{ let d; try{ d=JSON.parse(e.data); }catch(err){ return; } handleMsg(d); };
    }catch(e){}
    netUI();
  },
  send(msg){
    if(!this.room || !this.usable()) return;
    try{
      fetch(this.base()+"/send?room="+encodeURIComponent(this.room)+"&id="+this.id+
            (this.key?"&key="+encodeURIComponent(this.key):""), {
        method:"POST", headers:{"content-type":"application/json"},
        body:JSON.stringify(msg), keepalive:true
      }).then(r=>{
        if(r && r.status===403 && hostOK){ hostOK=false; netUI(); }   /* not the owner after all */
      }).catch(()=>{});
    }catch(e){}
  }
};
/* no server at all -> nothing to police, local play is always allowed */
let hostOK = false;
function mayHost(){ return !Net.usable() || hostOK; }
function checkHostKey(k){
  if(!Net.usable()) { hostOK=true; return Promise.resolve(true); }
  const key = String(k||"").trim().toUpperCase();
  return fetch(Net.base()+"/host"+(key?"?key="+encodeURIComponent(key):""))
    .then(r=>r.ok)
    .then(ok=>{
      if(ok){
        hostOK=true;
        if(key){ Net.key=key; try{ localStorage.setItem("taboo.hostkey", key); }catch(e){} }
      }
      netUI(); return ok;
    })
    .catch(()=>false);
}
function newRoom(){
  let c=""; for(let i=0;i<4;i++) c += ROOM_ALPHABET[Math.floor(Math.random()*ROOM_ALPHABET.length)];
  return c;
}
function netUI(){
  if(!$("netbar")) return;               /* the page is going away */
  if($("rpCode")) renderRoom();
  $("netbar").classList.toggle("on", Net.ready && Net.peers>1);
  $("netMsg").innerHTML = (!Net.usable() || !Net.room) ? T.netOffline
                        : (!Net.ready ? T.netWait : T.netLive(Math.max(Net.peers,1)));
  if($("teamsBtn")) $("teamsBtn").hidden = !mayHost();
  const help=$("netHelp");
  if(Net.usable() && Net.room && !menuEl.hidden){
    help.hidden=false; help.innerHTML = T.netHelp(Net.base(), Net.room);
  } else help.hidden=true;
}
function post(msg){
  msg.mid = Net.id+":"+(++mseq);
  seen.add(msg.mid);
  if(seen.size>500) seen.clear();
  if(bc) try{ bc.postMessage(msg); }catch(e){}
  Net.send(msg);
}
function stateMsg(){
  const inPlay = !playEl.hidden;
  const session = mode==="session" && S.seats.length;
  return {
    t:"state", mode, lang, host:Net.id,
    phase: inPlay?"play":(!readyEl.hidden?"ready":(!endEl.hidden?"end":(!finalEl.hidden?"final":"idle"))),
    lap:S.lap, laps:S.laps,
    teams:[{name:teamName(0),score:S.scores[0]},{name:teamName(1),score:S.scores[1]}],
    roster: S.seats.map((p,i)=>({i, name:p.name, id:p.id||null, team:teamOf(i), afk:!!p.afk, gone:!!p.gone})),
    turnSeat: session ? S.turnIdx : null,
    judgeSeat: session ? judgeIdx() : null,
    turnTeam: session ? teamOf(S.turnIdx) : null,
    player: session ? seatName(S.turnIdx) : null,
    judge:  session ? seatName(judgeIdx()) : null,
    turnPts: score - fouls,
    left, limit, round:{ok:score,pass:passes,buzz:fouls}
  };
}
/* The word only goes to the people allowed to see it: the describer's own
   team-mates are named in `not`, so the relay never sends it to their phones. */
function cardMsg(){
  if(playEl.hidden || !current) return null;
  const blocked = S.seats
    .map((p,i)=>({p,i}))
    .filter(({p,i}) => p.id && i!==S.turnIdx && teamOf(i)===teamOf(S.turnIdx))
    .map(({p}) => p.id);
  return {t:"card", not:blocked, card:{
    w:current.w, r:current.r, ng:current.ng.slice(),
    cat:(T.cats[current.c]||current.c), lvl:T.lvlName[current.d],
    no:$("cardNo").textContent, face:(slot<2?T.faceA:T.faceB)
  }};
}
/* only the device running the game talks about state */
function pushState(){
  if(onCompanion() || (following && !isHost)) return;
  post(stateMsg());
  const c = cardMsg();
  if(c) post(c);
}
function onCompanion(){ return COMPANIONS.some(el=>!el.hidden); }
/* An action arrives with the seat it came from (null = a shared judge screen).
   You may not award points to your own team or buzz your own describer. */
function applyAct(a, seat){
  if(playEl.hidden) return;
  const own = (seat!=null && seat>=0 && S.seats.length)
              ? teamOf(seat)===teamOf(S.turnIdx) : false;
  const isDesc = seat!=null && seat===S.turnIdx;
  if((a==="ok" || a==="buzz") && own) return;   /* not for your own team */
  if(a==="pass" && !(isDesc || seat==null)) return;  /* only the describer gives up on a word */
  if(a==="ok") scoreOk();
  else if(a==="pass") scorePass();
  else if(a==="buzz") registerBuzz();
  else if(a==="turn"){ if(!own || isDesc) turn(); }
}
/* my own taps: apply them here if this device runs the game, otherwise ask the host */
function intent(a){
  const seat = me ? me.seat : null;
  if(isHost || !following) applyAct(a, seat);
  else post({t:"act", a, seat});
}
function joinGame(){
  const nm = $("joinName").value.trim();
  if(!nm) return;
  savedSoon();
  const code = $("joinRoom").value.trim();
  if(code && code.toUpperCase() !== Net.room) Net.connect(code);
  me = {id:Net.id, name:nm, seat:-1};
  following = true; isHost = false; mode = "session";
  try{ localStorage.setItem("taboo.me", nm); }catch(e){}
  $("joinStatus").textContent = T.joinWait;
  post({t:"join", id:Net.id, name:nm});
  show(lobbyEl);
  $("lobbyWait").textContent = T.joinWait;
  clearTimeout(joinTimer);
  joinTimer = setTimeout(()=>{ if(me && me.seat<0) $("lobbyWait").textContent = T.joinNone; }, 5000);
}
let joinTimer=null;
function savedSoon(){ setTimeout(save, 0); }   /* after me/following settle */
/* walk straight back into the game after a refresh */
function resume(saved){
  if(saved.role === "player" && saved.me && saved.me.name){
    me = {id:Net.id, name:saved.me.name, seat:-1};
    following = true; isHost = false; mode = "session";
    $("joinName").value = saved.me.name;
    $("joinRoom").value = Net.room;
    show(lobbyEl);
    $("lobbyWait").textContent = T.rejoining;
    post({t:"join", id:Net.id, name:saved.me.name});
    clearTimeout(joinTimer);
    joinTimer = setTimeout(()=>{ if(me && me.seat<0) $("lobbyWait").textContent = T.joinNone; }, 7000);
    return true;
  }
  if(saved.role === "host" && saved.S && saved.S.active && S.seats.length>=4){
    isHost = true; following = false; mode = "session"; picked = true;
    gotoReady();                 /* an interrupted turn is simply taken again */
    return true;
  }
  return false;
}
/* a joined device is a puppet: the host's state decides what it shows */
function follow(s){
  if(isHost || !following) return;
  if(me && me.seat<0){
    const r=(s.roster||[]).find(x=>x.id===Net.id);
    if(r){ me.seat=r.i; me.name=r.name; save(); }
  }
  if(Array.isArray(s.roster))
    S.seats = s.roster.map(r=>({name:r.name, id:r.id, afk:r.afk, gone:r.gone, seen:0}));
  if(s.teams){ S.tnames=[s.teams[0].name,s.teams[1].name]; S.scores=[s.teams[0].score,s.teams[1].score]; }
  if(s.turnSeat!=null) S.turnIdx=s.turnSeat;
  S.judgePick = s.judgeSeat!=null ? s.judgeSeat : null;
  S.lap=s.lap; S.laps=s.laps;
  renderSeats();
  if(s.phase==="play"){
    paintFromState(s);
    if(playEl.hidden) show(playEl);
  }else if(s.phase==="ready"){
    LScard=null; paintCard(null);
    paintReady(); if(readyEl.hidden) show(readyEl);
  }else if(s.phase==="end"){
    $("finalScore").textContent = s.turnPts;
    $("fOk").textContent=s.round.ok; $("fPass").textContent=s.round.pass; $("fBuzz").textContent=s.round.buzz;
    $("addedTo").hidden=false;
    $("addedTo").innerHTML = T.addedTo(esc(teamName(s.turnTeam||0)), s.turnPts);
    $("endBoard").hidden=false; $("endBoard").innerHTML = boardHTML(s.turnTeam);
    $("againBtn").textContent = T.nextTurn;
    if(endEl.hidden) show(endEl);
  }else if(s.phase==="final"){
    $("winTeam").textContent = s.teams[0].score===s.teams[1].score ? T.drawLabel
      : teamName(s.teams[0].score>s.teams[1].score?0:1);
    $("winScore").textContent = Math.max(s.teams[0].score, s.teams[1].score);
    $("finBoard").innerHTML = boardHTML(-1);
    if(finalEl.hidden) show(finalEl);
  }else if(playEl.hidden && readyEl.hidden){
    if(lobbyEl.hidden && me && me.seat>=0) show(lobbyEl);
  }
  if(me && me.seat>=0) $("lobbyWait").textContent = T.lobbyWait;
  applyRole(s);
}
/* the card and clock, written from the host's state instead of the local deck */
function paintFromState(s){
  $("clock").textContent = fmt(Math.max(s.left,0));
  $("clock").classList.toggle("low", s.left<=10);
  hourglass(Math.max(s.left,0)/(s.limit||60), s.left<=10);
  $("score").textContent=s.round.ok; $("passes").textContent=s.round.pass; $("fouls").textContent=s.round.buzz;
  $("nowPlaying").hidden = !s.player;
  if(s.player) $("nowPlaying").innerHTML =
    `<span class="tag">${T.teamNum((s.turnTeam||0)+1)}</span><b>${esc(s.player)}</b>` +
    `<span>${esc(s.teams[s.turnTeam||0].name)}</span><span>${T.judgeShort}: ${esc(s.judge||"")}</span>`;
  paintCard(cardFresh() ? LScard : null);
}
/* null wipes it: a team-mate's phone must not be holding the word anywhere */
function paintCard(c){
  if(!c){
    $("reading").textContent=""; $("target").textContent="";
    $("ngList").innerHTML=""; $("cardNo").textContent=""; $("cardMeta").textContent="";
    $("reading2").textContent=""; $("target2").textContent=""; $("ngList2").innerHTML="";
    return;
  }
  $("reading").textContent=c.r; $("target").textContent=c.w;
  $("ngList").innerHTML = c.ng.map(x=>`<li>${esc(x)}</li>`).join("");
  $("reading2").textContent=""; $("target2").textContent="";
  $("ngList2").innerHTML="";
  $("cardNo").textContent=c.no||"";
  $("cardMeta").textContent = [c.face,c.cat,c.lvl].filter(Boolean).join(" · ");
}
function handleMsg(d){
  d = d || {};
  if(d.mid){
    if(seen.has(d.mid)) return;        /* already arrived on the other path */
    seen.add(d.mid);
    if(seen.size>500) seen.clear();
  }
  if(d.t === "peers"){ Net.peers = d.n||0; netUI(); return; }
  if(d.t === "card"){
    if(Array.isArray(d.not) && d.not.indexOf(Net.id) >= 0) return;   /* not for me */
    LScard = d.card; LScardAt = Date.now();
    if(!playEl.hidden && following && !isHost) paintCard(LScard);
    if(!judgeEl.hidden) renderLive();
    return;
  }

  /* ----- things only the device running the game acts on ----- */
  if(isHost || !following){
    if(d.t === "join"){
      const nm = String(d.name||"").trim().toLowerCase();
      let i = S.seats.findIndex(p=>p.id===d.id);
      /* same name = same person coming back: a reloaded phone reclaims its seat
         (and the name the host typed in advance) instead of adding a duplicate */
      if(i<0) i = S.seats.findIndex(p=>p.name.trim().toLowerCase()===nm);
      if(i<0){
        if(S.seats.length>=16) return;
        S.seats.push({name:String(d.name||"?").slice(0,14), id:d.id, afk:false, gone:false, seen:Date.now()});
      }else{
        S.seats[i].id=d.id; S.seats[i].name=String(d.name||S.seats[i].name).slice(0,14);
        S.seats[i].gone=false; S.seats[i].seen=Date.now();
      }
      renderSeats(); save(); pushState(); return;
    }
    if(d.t === "alive"){
      const p=S.seats.find(x=>x.id===d.id);
      if(p){ p.seen=Date.now(); if(p.gone){ p.gone=false; renderSeats(); pushState(); } }
      return;
    }
    if(d.t === "afk"){ setAfk(Number(d.seat), !!d.on); return; }
    if(d.t === "go"){ if(!readyEl.hidden){ mode="session"; start(); } return; }
    if(d.t === "next"){ if(!endEl.hidden) advanceAfterTurn(); return; }
    if(d.t === "skip"){ if(!readyEl.hidden) nextTurn(); return; }
  }

  if(d.t === "buzz"){ if(!playEl.hidden) registerBuzz(); }
  else if(d.t === "act"){ applyAct(d.a, d.seat!=null?d.seat:null); }
  else if(d.t === "ping"){ pushState(); }
  else if(d.t === "state"){
    LS=d; lsAt=Date.now(); lastPong=Date.now();
    follow(d);
    /* a companion window adopts the language the game is being played in */
    /* a companion screen or a joined player follows the language the host is running in */
    if((onCompanion() || following) && !langLocked && d.lang && d.lang!==lang){ lang=d.lang; applyLang(); }
    renderLive(); syncLabel();
  }
  else if(d.t === "round"){ if(!keepEl.hidden){ sk.pend=d.pts; skPaint(); } }
}
if(bc) bc.onmessage = e => handleMsg(e.data);
function live(){ return (LS && Date.now()-lsAt < 8000) ? LS : null; }
function syncLabel(){
  const l = !!live();
  $("bzSync").innerHTML = l ? T.bzLive : T.bzSolo;
}
function startPing(){
  stopPing();
  const p = ()=>{ post({t:"ping"}); renderLive(); syncLabel(); };
  p(); pingTimer = setInterval(p, 2500);
  clearInterval(liveTimer); liveTimer = setInterval(renderLive, 1000);
}
function stopPing(){ clearInterval(pingTimer); clearInterval(liveTimer); pingTimer=liveTimer=null; }

function liveHTML(s){
  const t = s.turnTeam;
  const who = s.player
    ? `<div class="live-now">${esc(s.player)}<small>${esc(t!=null?s.teams[t].name:"")} · ${T.judgeShort} ${esc(s.judge||"—")}</small></div>`
    : `<div class="live-now">${T.quickLive}<small>${T.ok} ${s.round.ok} · ${T.pass} ${s.round.pass} · ${T.buzz} ${s.round.buzz}</small></div>`;
  const board = `<div class="board">${s.teams.map((tm,i)=>
      `<div class="brow${i===t?" on":""}"><span class="who"><span>${esc(tm.name)}</span><small>${T.teamNum(i+1)}</small></span><b>${tm.score}</b></div>`
    ).join("")}</div>`;
  return `<div class="live-head"><span class="live-dot"><i></i>LIVE</span>
            <span>${s.laps ? T.lapOf(s.lap,s.laps) : T.lapEndless(s.lap)}</span></div>
          <div class="hud-row">${who}<div class="live-clock${s.left<=10?" low":""}">${fmt(Math.max(s.left,0))}</div></div>
          ${s.player ? board : ""}`;
}
function renderLive(){
  const s = live();
  [["bzLive",buzzEl],["jgLive",judgeEl],["skLive",keepEl]].forEach(([id,el])=>{
    const box=$(id);
    if(!s || el.hidden){ box.hidden=true; box.innerHTML=""; }
    else { box.hidden=false; box.innerHTML = liveHTML(s); }
  });
  if(!judgeEl.hidden) renderJudgeCard(s);
}
function renderJudgeCard(s){
  const c = (s && s.phase==="play" && cardFresh()) ? LScard : null;
  if(!c){
    $("jgCard").innerHTML=""; $("jgActions").hidden=true;
    $("jgWait").hidden=false; $("jgWait").innerHTML = T.jgWaiting;
    $("jgNote").hidden=true;
    return;
  }
  $("jgWait").hidden=true; $("jgActions").hidden=false;
  $("jgNote").hidden=false; $("jgNote").innerHTML = T.jgNote;
  $("jgCard").innerHTML = `
    <article class="card">
      <div class="side side-a">
        <div class="band">
          <div class="reading">${esc(c.r)}</div>
          <h2 class="target">${esc(c.w)}</h2>
        </div>
        <ul class="ng">${c.ng.map(x=>`<li>${esc(x)}</li>`).join("")}</ul>
      </div>
      <div class="seam">
        <span class="no">${esc(c.no)}</span>
        <span class="meta">${esc(c.face)} · ${esc(c.cat)} · ${esc(c.lvl)}</span>
      </div>
    </article>`;
}

/* ---------- ask before a buzz ---------- */
let askPending=null;
function askBuzz(fn){
  askPending = fn;
  $("askBuzz").hidden = false;
  try{ $("askYes").focus(); }catch(e){}
}
$("askYes").onclick = ()=>{ const f=askPending; askPending=null; $("askBuzz").hidden=true; if(f) f(); };
$("askNo").onclick  = ()=>{ askPending=null; $("askBuzz").hidden=true; };

/* ---------- companion: buzzer ---------- */
let bzCount=0;
function bzHit(){
  bzCount++; $("bzCount").textContent = bzCount;
  buzzFeedback(); post({t:"buzz"});
}
$("bzBtn").onclick   = ()=>askBuzz(bzHit);
$("bzReset").onclick = ()=>{ bzCount=0; $("bzCount").textContent=0; };
$("bzBack").onclick  = leaveCompanion;

/* ---------- companion: judge ---------- */
$("jgOk").onclick   = ()=>{ sOk(); post({t:"act",a:"ok"}); };
$("jgBuzz").onclick = ()=>askBuzz(()=>{ buzzFeedback(); post({t:"act",a:"buzz"}); });
$("jgBack").onclick = leaveCompanion;

/* ---------- companion: scorekeeper ---------- */
const sk = {a:0, b:0, log:[], pend:null};
function skPaint(){
  $("skPtsA").textContent = sk.a;
  $("skPtsB").textContent = sk.b;
  const box = $("skPending");
  if(sk.pend === null){ box.hidden = true; box.innerHTML=""; }
  else{
    box.hidden = false;
    box.innerHTML = T.skPend(sk.pend) +
      `<div style="display:flex;gap:6px;margin-top:8px">
         <button class="btn btn-light" type="button" data-pend="a" style="flex:1;font-size:13px;padding:10px 6px">${esc(T.skTo($("skNameA").value))}</button>
         <button class="btn btn-light" type="button" data-pend="b" style="flex:1;font-size:13px;padding:10px 6px">${esc(T.skTo($("skNameB").value))}</button>
       </div>`;
  }
}
function skAdd(team,d){ sk[team]+=d; sk.log.push([team,d]); skPaint(); save(); }
keepEl.addEventListener("click", e=>{
  const add=e.target.closest("button[data-team]");
  if(add){ skAdd(add.dataset.team, Number(add.dataset.d)); return; }
  const pend=e.target.closest("button[data-pend]");
  if(pend && sk.pend!==null){ const p=sk.pend; sk.pend=null; skAdd(pend.dataset.pend, p); }
});
$("skUndo").onclick  = ()=>{ const l=sk.log.pop(); if(l){ sk[l[0]]-=l[1]; skPaint(); save(); } };
$("skReset").onclick = ()=>{ sk.a=0; sk.b=0; sk.log=[]; sk.pend=null; skPaint(); save(); };
$("skBack").onclick  = leaveCompanion;
$("skNameA").oninput = save;
$("skNameB").oninput = save;

/* hang up when the phone locks or the tab closes, so the room's screen count is honest */
window.addEventListener("pagehide", ()=>{ if(Net.es) try{ Net.es.close(); }catch(e){} });

$("roomIn").addEventListener("change", ()=>Net.connect($("roomIn").value));
$("roomIn").addEventListener("keydown", e=>{
  if(e.code==="Enter"){ e.preventDefault(); Net.connect($("roomIn").value); e.target.blur(); }
});
$("netCopy").onclick = ()=>{
  const h = parseHash();
  const link = Net.base() ? Net.base()+"/#"+(h.screen || "judge")+"="+Net.room : Net.room;
  const done = ()=>{
    $("netCopy").textContent = T.copied;
    setTimeout(()=>{ $("netCopy").textContent = T.copyLink; }, 1400);
  };
  try{ navigator.clipboard.writeText(link).then(done, done); }catch(e){ done(); }
};

/* ---------- wiring ---------- */
/* the gate starts the app; the language of the cards is the host's setting */
$("gateStart").onclick = ()=>{ picked=true; applyLang(); show(menuEl); };
/* The buzzer / judge / scorekeeper screens are no longer offered: every
   opponent judges and buzzes from their own phone, and the scoreboard is in
   the game. The routes still answer (#buzzer / #judge / #score) if wanted. */

$("gearBtn").onclick = ()=>show(setEl);
$("setBack").onclick = ()=>show(backTo && backTo!==setEl ? backTo : (picked?menuEl:gateEl));
$("teamsBtn").onclick = ()=>{
  if(!mayHost()) return;                 /* not this machine: the button is not even shown */
  isHost=true; following=false; renderSeats(); show(setupEl);
};
$("joinBtn").onclick  = ()=>{ openJoin(); };
$("gateJoin").onclick = ()=>{ picked=true; applyLang(); openJoin(); };
function openJoin(){
  if(!$("joinName").value){
    try{ $("joinName").value = localStorage.getItem("taboo.me") || ""; }catch(e){}
  }
  $("joinRoom").value = Net.room || "";
  $("joinStatus").textContent = "";
  show(joinEl);
}
$("joinBack").onclick = ()=>show(picked ? menuEl : gateEl);
$("joinGo").onclick   = joinGame;
$("joinName").addEventListener("keydown", e=>{ if(e.code==="Enter"){ e.preventDefault(); joinGame(); } });
$("joinRoom").addEventListener("keydown", e=>{ if(e.code==="Enter"){ e.preventDefault(); joinGame(); } });
$("lobbyLeave").onclick = ()=>{
  me=null; following=false; clearTimeout(joinTimer);
  show(picked ? menuEl : gateEl);
};
$("setupBack").onclick = ()=>show(menuEl);
$("setupGo").onclick = startSession;
$("rdGo").onclick = ()=>{
  if(isHost || !following){ mode="session"; start(); }
  else post({t:"go"});                      /* the describer's phone asks the host to flip the sand */
};
$("rdSkip").onclick = ()=>{
  if(isHost || !following) nextTurn();
  else post({t:"skip"});
};
$("rdQuit").onclick = ()=>{ S.active=false; show(menuEl); save(); };
$("startBtn").onclick = ()=>{ mode="quick"; start(); };
$("rulesBtn").onclick = ()=>show(rulesEl);
$("backBtn").onclick  = ()=>show(menuEl);
function advanceAfterTurn(){
  if(mode==="session" && S.seats.length) nextTurn(); else show(menuEl);
}
$("againBtn").onclick = ()=>{
  if(isHost || !following) advanceAfterTurn();
  else post({t:"next"});
};
$("finAgain").onclick = ()=>{ S.scores=[0,0]; S.stats={}; S.turnIdx=0; S.lap=1; S.active=true; gotoReady(); };
$("finEdit").onclick  = ()=>{ renderSeats(); show(setupEl); };
$("finHome").onclick  = ()=>show(menuEl);
$("stopBtn").onclick  = finish;
$("okBtn").onclick    = ()=>intent("ok");
$("passBtn").onclick  = ()=>intent("pass");
$("buzzBtn").onclick  = ()=>askBuzz(()=>intent("buzz"));
$("turnBtn").onclick  = e=>{ e.stopPropagation(); intent("turn"); };
$("card").onclick     = e=>{ if(!e.target.closest("#turnBtn")) intent("turn"); };

document.addEventListener("keydown", e=>{
  const typing = /^(INPUT|TEXTAREA)$/.test(e.target.tagName);
  if(typing) return;
  if(!$("askBuzz").hidden){
    if(e.code==="Escape"){ e.preventDefault(); $("askNo").click(); }
    else if(e.code==="Enter"){ e.preventDefault(); $("askYes").click(); }
    return;
  }
  if(!playEl.hidden){
    if(e.code==="Space"){ e.preventDefault(); if(!$("okBtn").hidden) intent("ok"); }
    else if(e.code==="ArrowRight"){ e.preventDefault(); if(!$("passBtn").hidden) intent("pass"); }
    else if(e.key==="b"||e.key==="B"){ e.preventDefault(); if(!$("buzzBtn").hidden) askBuzz(()=>intent("buzz")); }
    else if(e.key==="r"||e.key==="R"||e.code==="ArrowDown"){ e.preventDefault(); intent("turn"); }
  } else if(!buzzEl.hidden){
    if((e.code==="Space"||e.code==="Enter") && document.activeElement!==$("bzBtn")){ e.preventDefault(); bzHit(); }
  } else if(!judgeEl.hidden){
    if(e.code==="Space"){ e.preventDefault(); $("jgOk").click(); }
    else if(e.key==="b"||e.key==="B"){ e.preventDefault(); $("jgBuzz").click(); }
  } else if(!joinEl.hidden){
    if(e.code==="Enter"){ e.preventDefault(); joinGame(); }
  } else if(!gateEl.hidden){
    if(e.code==="Enter"||e.code==="Space"){ e.preventDefault(); $("gateStart").click(); }
  } else if(!readyEl.hidden){
    if(e.code==="Enter"||e.code==="Space"){ e.preventDefault(); $("rdGo").click(); }
  } else if(!menuEl.hidden || !setEl.hidden){
    if(!menuEl.hidden && e.code==="Enter") $("teamsBtn").click();
    else if(e.key==="t"||e.key==="T"){ skin = SKINS[(SKINS.indexOf(skin)+1)%SKINS.length]; applySkin(); }
  }
});

/* ---------- presence: a phone that goes quiet gets skipped, not waited for ---------- */
setInterval(()=>{
  if(following && me && me.seat>=0) post({t:"alive", id:Net.id});
  if(isHost || !following){
    const now=Date.now(); let changed=false;
    S.seats.forEach(p=>{
      if(p.id && p.id!==Net.id){
        const gone = (now-(p.seen||0)) > 30000;
        if(gone !== !!p.gone){ p.gone=gone; changed=true; }
      }
    });
    if(changed){ renderSeats(); if(!readyEl.hidden) paintReady(); pushState(); save(); }
  }
}, 6000);

/* ---------- boot ---------- */
(function boot(){
  const s = load();
  if(SKINS.includes(s.skin)) skin=s.skin;
  if(typeof s.sound==="boolean") sound=s.sound;
  if(s.lang==="en"||s.lang==="ja") lang=s.lang;
  if(s.deckLang==="en"||s.deckLang==="ja") deckLang=s.deckLang;
  if(Number.isFinite(s.level)) level=s.level;
  if(Number.isFinite(s.limit)) limit=s.limit;
  if(s.S){
    if(Array.isArray(s.S.seats)) S.seats = s.S.seats.slice(0,16).map(x =>
      typeof x === "string" ? {name:x, id:null, afk:false, gone:false, seen:0}
                            : {name:String(x.name||"?"), id:null, afk:!!x.afk, gone:false, seen:0});
    if(Array.isArray(s.S.tnames)) S.tnames=s.S.tnames;
    if(Array.isArray(s.S.scores)) S.scores=s.S.scores;
    if(s.S.stats && typeof s.S.stats==="object") S.stats=s.S.stats;
    if(Number.isFinite(s.S.laps)) S.laps=s.S.laps;
    if(Number.isFinite(s.S.lap)) S.lap=s.S.lap;
    if(Number.isFinite(s.S.turnIdx)) S.turnIdx=s.S.turnIdx;
  }
  if(s.sk){
    sk.a=Number(s.sk.a)||0; sk.b=Number(s.sk.b)||0;
    if(s.sk.na) $("skNameA").value=s.sk.na;
    if(s.sk.nb) $("skNameB").value=s.sk.nb;
  }
  $("tName0").value = S.tnames[0]||""; $("tName1").value = S.tnames[1]||"";
  document.querySelectorAll("#segLevel button").forEach(b=>b.setAttribute("aria-pressed",String(Number(b.dataset.v)===level)));
  document.querySelectorAll("#segTime button").forEach(b=>b.setAttribute("aria-pressed",String(Number(b.dataset.v)===limit)));
  document.querySelectorAll("#segLaps button").forEach(b=>b.setAttribute("aria-pressed",String(Number(b.dataset.v)===S.laps)));
  let room="";
  try{ room = localStorage.getItem("taboo.room") || ""; }catch(e){}
  if(s.room) room = s.room;
  const h = parseHash();
  if(h.room) room = h.room;
  if(!room) room = newRoom();
  picked = !!s.picked;
  try{ Net.key = localStorage.getItem("taboo.hostkey") || ""; }catch(e){}
  try{
    const q = new URLSearchParams(location.search).get("host");
    if(q) Net.key = q.toUpperCase();
  }catch(e){}
  checkHostKey(Net.key);              /* no key needed when this IS the machine */
  applySkin(); applyDeck(); applyLang(); skPaint(); hourglass(1,false);
  Net.connect(room);
  if(parseHash().screen) return route();     /* an explicit #judge / #buzzer link wins */
  if(resume(s)) return;
  route();
})();
</script>
