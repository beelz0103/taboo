<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#D40D2A">
<title>タブー</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+JP:wght@500;700;900&display=swap">
<style>
/* Anton, embedded. The phones at a party are on a LAN with no internet, so a
   webfont from Google never arrives — and the fallback (Impact) has glyphs that
   overflow their line box and collide with the label above. This ships with us. */
@font-face{
  font-family:"Anton";
  font-style:normal;font-weight:400;font-display:swap;
  src:url(data:font/woff2;base64,) format("woff2");
}
/* ================= THEMES =================
   every colour in this sheet comes from these tokens, so a skin is
   just one block of overrides. :root = CLASSIC.
   --pop / --pop-ink : accent that sits on the GROUND (buttons, pills, bars)
   --mark / --mark-hi: accent that sits on a CARD (kickers, rules, pips)
   --ink / --ink-on  : the deepest surface (card band, dark buttons) + its text
========================================== */
:root{
  --ground:#D40D2A; --ground-2:#9E0A20; --glow-top:rgba(255,255,255,.10);
  --on:#FFFFFF; --on-soft:rgba(255,255,255,.72); --on-line:rgba(255,255,255,.28);
  --ink:#121212; --ink-on:#FFFFFF;
  --pop:#FFFFFF; --pop-2:#EFDCDF; --pop-ink:#121212;
  --mark:#D40D2A; --mark-hi:#A2545F; --reading:#FF9AA4;
  --hi:#FFD400; --flash:#FFD400;
  --card:#FFFFFF; --card-alt:#FBE7EA; --card-ink:#141414; --card-body:#2B2B2B;
  --card-sub:#9A9A9A; --card-line:rgba(0,0,0,.14); --sheen:rgba(0,0,0,0);
  --deck-1:rgba(255,255,255,.28); --deck-2:rgba(255,255,255,.16);
  --buzz-1:#FF7A6E; --buzz-2:#E01228; --buzz-3:#8E0416;
  --drop:rgba(0,0,0,.45); --glow:0 0 0 rgba(0,0,0,0);
  --seam:rgba(0,0,0,.05); --panel:rgba(0,0,0,.22); --bar-bg:rgba(0,0,0,.32);
  --plaque-bg:#FFFFFF; --plaque-ink:#D40D2A; --plaque-line:#121212;
}
:root[data-skin="neon"]{
  --ground:#0C0B18; --ground-2:#050409; --glow-top:rgba(0,229,255,.18);
  --on:#EAF6FF; --on-soft:rgba(234,246,255,.60); --on-line:rgba(0,229,255,.28);
  --ink:#07060E; --ink-on:#EAF6FF;
  --pop:#00E5FF; --pop-2:#0091AD; --pop-ink:#04121A;
  --mark:#FF2FB9; --mark-hi:#FF87D8; --reading:#00E5FF;
  --hi:#FFE83D; --flash:#FF2FB9;
  --card:#100F1E; --card-alt:#1A1936; --card-ink:#F2F7FF; --card-body:#C6D2E8;
  --card-sub:#6F7BA0; --card-line:rgba(0,229,255,.26); --sheen:rgba(0,229,255,.12);
  --deck-1:#1B1A36; --deck-2:#131226;
  --buzz-1:#FF9AE0; --buzz-2:#FF2FB9; --buzz-3:#77004F;
  --drop:#001A22; --glow:0 0 22px rgba(0,229,255,.30);
  --seam:rgba(0,0,0,.34); --panel:rgba(0,0,0,.34); --bar-bg:rgba(0,0,0,.5);
  --plaque-bg:#07060E; --plaque-ink:#00E5FF; --plaque-line:#FF2FB9;
}
:root[data-skin="poison"]{
  --ground:#1A0A2E; --ground-2:#06010B; --glow-top:rgba(177,75,255,.26);
  --on:#F0E2FF; --on-soft:rgba(240,226,255,.60); --on-line:rgba(183,109,255,.32);
  --ink:#0B0413; --ink-on:#F6ECFF;
  --pop:#B14BFF; --pop-2:#7A18C9; --pop-ink:#12001F;
  --mark:#C471FF; --mark-hi:#E9B6FF; --reading:#E9B6FF;
  --hi:#C6FF3D; --flash:#B14BFF;
  --card:#170A24; --card-alt:#220E36; --card-ink:#F3E7FF; --card-body:#DCC9EE;
  --card-sub:#8E6BB5; --card-line:rgba(177,75,255,.32); --sheen:rgba(177,75,255,.14);
  --deck-1:#2C1042; --deck-2:#1E0A2E;
  --buzz-1:#E9B6FF; --buzz-2:#A21CF0; --buzz-3:#4A0A7A;
  --drop:#2A0842; --glow:0 0 24px rgba(177,75,255,.34);
  --seam:rgba(0,0,0,.3); --panel:rgba(0,0,0,.3); --bar-bg:rgba(0,0,0,.45);
  --plaque-bg:#0B0413; --plaque-ink:#B14BFF; --plaque-line:#B14BFF;
}
:root[data-skin="midnight"]{
  --ground:#141C3A; --ground-2:#070B1B; --glow-top:rgba(255,199,102,.14);
  --on:#F2F4FF; --on-soft:rgba(242,244,255,.62); --on-line:rgba(255,255,255,.24);
  --ink:#0B1027; --ink-on:#FFF8EA;
  --pop:#FFC766; --pop-2:#D89A2E; --pop-ink:#1B1405;
  --mark:#1E3A9E; --mark-hi:#8A6A28; --reading:#FFC766;
  --hi:#FFE083; --flash:#FFC766;
  --card:#FBF6EC; --card-alt:#F0E6D4; --card-ink:#171A2B; --card-body:#3A3F55;
  --card-sub:#9A9583; --card-line:rgba(0,0,0,.14); --sheen:rgba(0,0,0,0);
  --deck-1:rgba(255,255,255,.26); --deck-2:rgba(255,255,255,.13);
  --buzz-1:#FFE1A6; --buzz-2:#E8A33A; --buzz-3:#7A4E08;
  --drop:rgba(0,0,0,.5); --glow:0 0 20px rgba(255,199,102,.18);
  --seam:rgba(0,0,0,.05); --panel:rgba(0,0,0,.3); --bar-bg:rgba(0,0,0,.4);
  --plaque-bg:#FBF6EC; --plaque-ink:#1E3A9E; --plaque-line:#FFC766;
}
:root[data-skin="washi"]{
  --ground:#EFE8DC; --ground-2:#D9CDBA; --glow-top:rgba(255,255,255,.55);
  --on:#1E1A16; --on-soft:rgba(30,26,22,.60); --on-line:rgba(30,26,22,.22);
  --ink:#171310; --ink-on:#F7F2E8;
  --pop:#C8102E; --pop-2:#8E0A1F; --pop-ink:#FFF6EE;
  --mark:#C8102E; --mark-hi:#8A6A3A; --reading:#E8A0A8;
  --hi:#C8102E; --flash:#C8102E;
  --card:#FCF8F0; --card-alt:#F2E7D6; --card-ink:#171310; --card-body:#3B332B;
  --card-sub:#A2937E; --card-line:rgba(23,19,16,.16); --sheen:rgba(0,0,0,0);
  --deck-1:rgba(23,19,16,.16); --deck-2:rgba(23,19,16,.08);
  --buzz-1:#FF9A8E; --buzz-2:#C8102E; --buzz-3:#6E0413;
  --drop:rgba(23,19,16,.30); --glow:0 0 0 rgba(0,0,0,0);
  --seam:rgba(23,19,16,.05); --panel:rgba(23,19,16,.07); --bar-bg:rgba(23,19,16,.18);
  --plaque-bg:#171310; --plaque-ink:#F7F2E8; --plaque-line:#C8102E;
}
/* swatches in the picker keep their own colours whatever the active skin */
.skins{display:grid;grid-template-columns:repeat(auto-fit,minmax(84px,1fr));gap:6px}
.skins button{
  display:flex;flex-direction:column;gap:6px;align-items:stretch;
  padding:7px 7px 8px;border:2px solid var(--on-line);border-radius:8px;
  background:transparent;color:var(--on-soft);cursor:pointer;font-weight:900;
  font-size:9.5px;letter-spacing:.1em;min-height:44px;
}
.skins button[aria-pressed="true"]{border-color:var(--pop);color:var(--on);box-shadow:var(--glow)}
.skins button:focus-visible{outline:3px solid var(--hi);outline-offset:2px}
.skins .sw{display:block;height:18px;border-radius:4px;border:1px solid rgba(0,0,0,.28)}
.sw-classic {background:linear-gradient(90deg,#D40D2A 0 46%,#FFFFFF 46% 76%,#121212 76% 100%)}
.sw-neon    {background:linear-gradient(90deg,#0C0B18 0 40%,#00E5FF 40% 72%,#FF2FB9 72% 100%)}
.sw-poison  {background:linear-gradient(90deg,#1A0A2E 0 42%,#B14BFF 42% 74%,#C6FF3D 74% 100%)}
.sw-midnight{background:linear-gradient(90deg,#141C3A 0 44%,#FFC766 44% 74%,#FBF6EC 74% 100%)}
.sw-washi   {background:linear-gradient(90deg,#EFE8DC 0 44%,#C8102E 44% 74%,#171310 74% 100%)}

*{box-sizing:border-box}
html{height:100%;-webkit-text-size-adjust:100%}
body{
  margin:0;
  min-height:100%;min-height:100dvh;
  background:var(--ground);
  background-image:
    radial-gradient(120% 80% at 50% -15%, var(--glow-top) 0%, rgba(0,0,0,0) 62%),
    radial-gradient(130% 95% at 50% 0%, var(--ground) 0%, var(--ground-2) 100%);
  background-attachment:fixed;
  color:var(--on);
  font-family:"Noto Sans JP","Hiragino Kaku Gothic ProN",system-ui,sans-serif;
  font-weight:700;
  -webkit-font-smoothing:antialiased;
  -webkit-tap-highlight-color:transparent;
  display:flex;justify-content:center;
  padding:18px 18px calc(26px + env(safe-area-inset-bottom));
}
.app{width:100%;max-width:520px;display:flex;flex-direction:column;gap:16px}
.en{font-family:"Anton",Impact,sans-serif;font-weight:400;letter-spacing:.06em}
button{touch-action:manipulation;font-family:inherit}
.screen{display:flex;flex-direction:column;gap:14px}
#menu{gap:18px}
[hidden]{display:none !important}

/* --- top bar --- */
.top{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:36px;padding:0 2px}
.lang{display:flex;border:2px solid var(--on-line);border-radius:999px;overflow:hidden}
.lang button{
  font-family:"Anton",sans-serif;font-size:12px;letter-spacing:.1em;
  background:none;border:0;color:var(--on-soft);padding:7px 12px;cursor:pointer;
}
.lang button[aria-pressed="true"]{background:var(--pop);color:var(--pop-ink)}
.lang button:focus-visible,.linkbtn:focus-visible{outline:2px solid var(--hi);outline-offset:2px}
.linkbtn{
  background:none;border:0;color:var(--on-soft);cursor:pointer;
  font-weight:700;font-size:13px;letter-spacing:.06em;
  text-decoration:underline;text-underline-offset:4px;padding:8px 4px;
}

/* --- logo --- */
.logo{display:inline-flex;flex-direction:column;align-items:center;gap:6px;align-self:center;margin:2vh 0 0}
.plaque{
  background:var(--plaque-bg);color:var(--plaque-ink);
  font-size:clamp(52px,17vw,86px);font-weight:900;line-height:1.1;
  padding:14px 26px 18px;border-radius:14px;
  border:5px solid var(--plaque-line);
  box-shadow:8px 8px 0 var(--drop), var(--glow);
  transform:rotate(-2.5deg);letter-spacing:.04em;
}
.logo .sub{
  font-family:"Anton",sans-serif;font-size:clamp(15px,4.4vw,20px);
  letter-spacing:.52em;padding-left:.52em;color:var(--on);margin-top:10px;
}
.tagline{text-align:center;color:var(--on-soft);font-size:13px;letter-spacing:.04em;line-height:1.7;margin:0}

/* --- buttons --- */
.btn{
  font-weight:900;font-size:19px;
  border:2px solid var(--on-line);border-radius:10px;cursor:pointer;padding:16px 18px;
  background:var(--ink);color:var(--ink-on);box-shadow:0 5px 0 var(--drop);
  transition:transform .07s ease,box-shadow .07s ease;
}
.btn:active{transform:translateY(4px);box-shadow:0 1px 0 var(--drop)}
.btn:focus-visible{outline:3px solid var(--hi);outline-offset:3px}
.btn-light{
  background:linear-gradient(180deg,var(--pop) 0%,var(--pop-2) 100%);
  color:var(--pop-ink);border-color:transparent;box-shadow:0 5px 0 var(--drop),var(--glow);
}
.btn-ghost{background:transparent;color:var(--on);border:3px solid var(--on-line);box-shadow:none}
.btn-ghost:active{transform:translateY(2px)}

.field{display:flex;flex-direction:column;gap:8px}
.label{font-size:11px;letter-spacing:.2em;color:var(--on-soft);font-weight:900}
.seg{display:flex;gap:6px}
.seg button{
  flex:1;font-weight:900;font-size:14px;padding:12px 2px;min-height:44px;
  border:2px solid var(--on-line);border-radius:8px;background:transparent;color:var(--on-soft);
  cursor:pointer;font-variant-numeric:tabular-nums;
}
.seg button[aria-pressed="true"]{background:var(--pop);color:var(--pop-ink);border-color:var(--pop);box-shadow:var(--glow)}
.seg button:focus-visible{outline:3px solid var(--hi);outline-offset:2px}
.count{text-align:center;font-size:12px;color:var(--on-soft);letter-spacing:.06em;font-variant-numeric:tabular-nums}
.links{display:flex;flex-direction:column;gap:2px;align-items:center;padding-top:2px}

/* --- language gate --- */
.gate{display:flex;flex-direction:column;gap:20px;text-align:center;min-height:calc(100dvh - 36px);justify-content:center}
.gate .logo{margin:0}
.gate .ask{font-size:12.5px;letter-spacing:.14em;color:var(--on-soft);line-height:2.1;margin:0}
.gate .ask .en{display:block;font-size:12px;letter-spacing:.2em}
.pick{display:flex;flex-direction:column;gap:11px}
.pick .btn{display:flex;flex-direction:column;align-items:center;gap:5px}
.pick .btn .big{font-size:23px;line-height:1.1}
.pick .btn .small{font-family:"Anton",sans-serif;font-size:10.5px;letter-spacing:.22em;opacity:.72;font-weight:400}

/* --- rules --- */
.sheet{
  background:var(--card);color:var(--card-ink);border-radius:14px;
  padding:26px 22px;border:2px solid var(--card-line);
  box-shadow:0 8px 0 var(--drop),var(--glow);
  display:flex;flex-direction:column;gap:22px;
}
.sheet-head{display:flex;flex-direction:column;gap:7px}
/* on the ground use the ground-contrast colour; --mark is a colour for CARDS
   and in CLASSIC it is literally the ground colour (invisible red on red) */
.kicker{font-family:"Anton",sans-serif;font-size:11px;letter-spacing:.26em;color:var(--on-soft);line-height:1}
.sheet .kicker{color:var(--mark)}
.rd-team{color:var(--mark)}
.sheet h2{font-size:24px;margin:0;font-weight:900;line-height:1.25}
.steps{list-style:none;margin:0;padding:0;counter-reset:s;display:flex;flex-direction:column;gap:16px}
.steps li{
  display:grid;grid-template-columns:28px 1fr;gap:14px;align-items:start;
  font-size:15px;line-height:1.75;font-weight:500;color:var(--card-body);
}
.steps li::before{
  counter-increment:s;content:counter(s);
  font-family:"Anton",sans-serif;font-size:15px;line-height:26px;text-align:center;
  background:var(--mark);color:#fff;border-radius:6px;height:26px;width:28px;
}
.steps li > span{min-width:0}
.steps b{font-weight:900;color:var(--card-ink)}
.scoreblock{background:var(--card-alt);border-radius:10px;padding:15px 16px;display:flex;flex-direction:column;gap:9px}
.scoreblock .kicker{color:var(--mark-hi)}
.scoring{display:flex;flex-direction:column;gap:7px}
.scoring div{display:flex;justify-content:space-between;align-items:baseline;font-size:14.5px;font-weight:700}
.scoring span{font-weight:900;color:var(--mark);font-variant-numeric:tabular-nums}
.note{margin:0;font-size:12.5px;line-height:1.8;color:var(--card-sub);font-weight:500;border-top:2px solid var(--card-alt);padding-top:18px}

/* --- hud --- */
.hud{display:flex;flex-direction:column;gap:9px}
.hud-row{display:flex;align-items:center;justify-content:space-between;gap:10px}
.clock{font-family:"Anton",Impact,sans-serif;font-size:38px;line-height:1.1;letter-spacing:.02em;font-variant-numeric:tabular-nums}
.clock.low{color:var(--hi)}
.tally{display:flex;gap:14px;align-items:baseline;font-size:11px;letter-spacing:.14em;color:var(--on-soft)}
.tally b{font-family:"Anton",sans-serif;font-size:23px;color:var(--on);letter-spacing:0;margin-left:5px}
.bar{height:7px;border-radius:99px;background:var(--bar-bg);overflow:hidden}
.bar i{display:block;height:100%;background:var(--pop);transform-origin:left center;transition:transform 1s linear,background .2s}
.bar i.low{background:var(--hi)}

/* --- the card: 4 words per card, two ends per face --- */
.deck{position:relative;perspective:1200px}
.deck::before,.deck::after{
  content:"";position:absolute;inset:8px -6px -10px;border-radius:16px;
  background:var(--deck-1);z-index:0;
}
.deck::after{inset:14px -12px -18px;background:var(--deck-2)}
.card{
  position:relative;z-index:1;background:var(--card);color:var(--card-ink);
  border-radius:16px;overflow:hidden;border:2px solid var(--card-line);
  box-shadow:0 14px 30px -12px rgba(0,0,0,.6),var(--glow);
  display:flex;flex-direction:column;min-height:min(50dvh,392px);
  cursor:pointer;user-select:none;-webkit-user-select:none;
}
.card::after{
  content:"";position:absolute;inset:0;pointer-events:none;z-index:2;
  background:radial-gradient(120% 60% at 50% 0%,var(--sheen),rgba(0,0,0,0) 60%);
}
.side{display:flex;flex-direction:column;min-height:0}
.side-a{flex:1 1 auto}
.side-b{flex:0 0 auto;transform:rotate(180deg);opacity:.4}
.band{background:var(--ink);padding:18px 16px 16px;text-align:center;border-bottom:5px solid var(--mark);position:relative}
.side-b .band{padding:11px 14px 10px;border-bottom-width:3px}
.reading{font-size:12px;letter-spacing:.22em;color:var(--reading);font-weight:700;min-height:15px;margin-bottom:5px}
.side-b .reading{font-size:10px;min-height:0;margin-bottom:2px}
.target{
  margin:0;color:var(--ink-on);font-weight:900;line-height:1.12;
  font-size:clamp(30px,8.6vw,46px);letter-spacing:.02em;text-wrap:balance;
}
.side-b .target{font-size:clamp(17px,4.6vw,22px)}
.ng{list-style:none;margin:0;padding:0;flex:1;display:flex;flex-direction:column;min-height:0}
.ng li{
  flex:1;display:flex;align-items:center;justify-content:center;
  font-size:clamp(17px,5vw,22px);font-weight:900;letter-spacing:.02em;
  padding:8px 12px;text-align:center;min-height:40px;
}
.ng li:nth-child(odd){background:var(--card-alt)}
.side-b .ng{flex:0 0 auto;flex-direction:row;flex-wrap:wrap;justify-content:center;gap:0 10px;padding:5px 12px 7px}
.side-b .ng li{flex:0 0 auto;min-height:0;padding:1px 0;font-size:11.5px;font-weight:700;background:none !important;color:var(--card-sub)}
/* the fold between the two ends */
.seam{
  display:flex;justify-content:space-between;align-items:center;gap:8px;
  padding:7px 12px;font-size:9.5px;letter-spacing:.13em;color:var(--card-sub);font-weight:700;
  border-top:2px dashed var(--card-line);border-bottom:2px dashed var(--card-line);
  background:var(--seam);
}
.seam .no{font-family:"Anton",sans-serif;letter-spacing:.1em;white-space:nowrap}
.seam .meta{text-align:right;min-width:0}
.pips{display:flex;gap:4px;align-items:center;flex:none}
.pips i{width:12px;height:4px;border-radius:2px;background:var(--card-line)}
.pips i.on{background:var(--mark)}
/* turn-the-card affordance */
.turn{
  position:absolute;top:8px;right:8px;z-index:3;
  width:38px;height:38px;border-radius:50%;cursor:pointer;
  background:rgba(0,0,0,.35);border:1.5px solid var(--card-line);color:var(--ink-on);
  font-size:17px;line-height:1;display:grid;place-items:center;
}
.turn:active{transform:scale(.92)}
.turn:focus-visible{outline:3px solid var(--hi);outline-offset:2px}

.deal{animation:deal .22s cubic-bezier(.2,.75,.3,1)}
@keyframes deal{from{opacity:0;transform:translateY(-14px) rotate(1.2deg) scale(.97)}to{opacity:1;transform:none}}
.spin{animation:spin .34s cubic-bezier(.3,.7,.2,1)}
@keyframes spin{from{transform:rotate(-180deg) scale(.94)}to{transform:none}}
.flip{animation:flip .38s cubic-bezier(.3,.7,.2,1)}
@keyframes flip{from{transform:rotateY(-180deg) scale(.94)}to{transform:none}}
.shake{animation:shake .32s}
@keyframes shake{0%,100%{transform:none}20%{transform:translateX(-9px) rotate(-1deg)}50%{transform:translateX(8px) rotate(1deg)}80%{transform:translateX(-4px)}}

/* --- actions --- */
.actions{display:flex;flex-direction:column;gap:9px}
.arow{display:flex;gap:9px;align-items:stretch}
.arow .btn{flex:1;font-size:21px}
.buzzer{flex:none;width:var(--bz,78px);border:0;background:none;padding:0;cursor:pointer;transition:transform .07s ease}
.buzzer:active{transform:translateY(4px)}
.buzzer:focus-visible{outline:3px solid var(--hi);outline-offset:3px;border-radius:50%}
.buzzer i{
  display:grid;place-items:center;width:var(--bz,78px);height:var(--bz,78px);border-radius:50%;
  background:var(--ink);box-shadow:0 5px 0 var(--drop),var(--glow);
}
.buzzer i::before{
  content:attr(data-buzz);width:calc(var(--bz,78px) - 18px);height:calc(var(--bz,78px) - 18px);
  border-radius:50%;
  background:radial-gradient(circle at 34% 28%,var(--buzz-1),var(--buzz-2) 56%,var(--buzz-3));
  color:#fff;font-size:11px;font-weight:900;letter-spacing:.06em;
  display:grid;place-items:center;font-style:normal;text-align:center;
  box-shadow:inset 0 -3px 7px rgba(0,0,0,.45);
}
.hint{text-align:center;font-size:11px;color:var(--on-soft);letter-spacing:.08em;font-weight:500;line-height:1.8}

/* --- end --- */
.end{display:flex;flex-direction:column;gap:16px;text-align:center;padding-top:1vh}
.bigscore{
  font-family:"Anton",Impact,sans-serif;font-size:clamp(58px,17vw,96px);
  line-height:1.22;margin:8px 0 0;color:var(--pop);
}
.end .label{margin-bottom:2px}
.scoreline{display:flex;flex-direction:column;gap:0}
.breakdown{display:flex;justify-content:center;gap:26px;font-size:11px;letter-spacing:.14em;color:var(--on-soft)}
.breakdown b{display:block;font-family:"Anton",sans-serif;font-size:26px;color:var(--on);letter-spacing:0;margin-top:4px}
.missed{
  text-align:left;background:var(--panel);border:1px solid var(--on-line);border-radius:10px;
  padding:14px 16px;font-size:13px;line-height:1.9;color:var(--on-soft);font-weight:500;
}
.missed b{display:block;font-size:10px;letter-spacing:.18em;color:var(--on);margin-bottom:6px}

/* --- companions: buzzer + scorekeeper --- */
.pane{display:flex;flex-direction:column;gap:12px;min-height:calc(100dvh - 76px)}
.pane-hint{margin:0;text-align:center;font-size:12px;line-height:1.9;color:var(--on-soft);font-weight:500}
.pad{flex:1;display:grid;place-items:center;padding:4px 0}
.bz-btn{
  width:min(74vw,300px);aspect-ratio:1;border-radius:50%;border:3px solid var(--on-line);
  padding:0;cursor:pointer;background:var(--ink);display:grid;place-items:center;
  box-shadow:0 12px 0 var(--drop),var(--glow);
  transition:transform .07s ease,box-shadow .07s ease;
}
.bz-btn:active{transform:translateY(10px);box-shadow:0 2px 0 var(--drop),var(--glow)}
.bz-btn:focus-visible{outline:4px solid var(--hi);outline-offset:4px}
.bz-btn span{
  width:84%;aspect-ratio:1;border-radius:50%;display:grid;place-items:center;
  background:radial-gradient(circle at 34% 26%,var(--buzz-1),var(--buzz-2) 52%,var(--buzz-3));
  color:#fff;font-weight:900;font-size:clamp(26px,9vw,44px);letter-spacing:.04em;
  box-shadow:inset 0 -10px 20px rgba(0,0,0,.4);
}
.pane-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.counter{font-size:11px;letter-spacing:.16em;color:var(--on-soft)}
.counter b{font-family:"Anton",sans-serif;font-size:26px;color:var(--pop);margin-left:8px;letter-spacing:0;font-variant-numeric:tabular-nums}
.aside{
  font-size:10.5px;letter-spacing:.12em;color:var(--on-soft);text-align:center;
  border:1px dashed var(--on-line);border-radius:8px;padding:8px 10px;line-height:1.7;
}
/* scorekeeper */
.teams{display:grid;grid-template-columns:1fr 1fr;gap:10px;flex:1;align-content:start}
.team{
  display:flex;flex-direction:column;gap:10px;align-items:stretch;
  background:var(--panel);border:1px solid var(--on-line);border-radius:12px;padding:12px 10px;
}
.team input{
  width:100%;background:transparent;border:0;border-bottom:2px solid var(--on-line);
  color:var(--on);font-family:inherit;font-weight:900;font-size:14px;letter-spacing:.1em;
  text-align:center;padding:4px 2px;min-width:0;
}
.team input:focus{outline:0;border-bottom-color:var(--pop)}
.team .pts{
  font-family:"Anton",Impact,sans-serif;font-size:clamp(46px,15vw,70px);line-height:1.15;text-align:center;
  color:var(--pop);font-variant-numeric:tabular-nums;
}
.team .row{display:flex;gap:6px}
.team .row .btn{flex:1;font-size:18px;padding:13px 6px}
.sk-note{font-size:10px;letter-spacing:.1em;color:var(--on-soft);text-align:center;font-weight:700}

/* --- "are you sure?" before a buzz costs somebody a point --- */
.buzzask{position:fixed;inset:0;z-index:60;display:grid;place-items:center;padding:20px;
  background:rgba(0,0,0,.72);backdrop-filter:blur(2px)}
.askcard{
  width:100%;max-width:330px;background:var(--card);color:var(--card-ink);
  border:2px solid var(--card-line);border-radius:16px;padding:22px 18px;
  box-shadow:0 12px 0 var(--drop),var(--glow);text-align:center;
  display:flex;flex-direction:column;gap:12px;
}
.asktitle{font-size:20px;font-weight:900;line-height:1.2}
.askbody{margin:0;font-size:13px;line-height:1.8;color:var(--card-sub);font-weight:500}
.askrow{display:flex;flex-direction:column;gap:8px;margin-top:4px}
.askrow .btn{font-size:16px;padding:14px 12px}

.gear{
  background:transparent;border:2px solid var(--on-line);border-radius:999px;
  color:var(--on-soft);cursor:pointer;font-size:15px;line-height:1;flex:none;
  width:36px;height:36px;display:grid;place-items:center;
}
.gear:focus-visible{outline:2px solid var(--hi);outline-offset:2px}
.setrow{display:flex;align-items:center;justify-content:space-between;gap:10px}

/* --- the game master's room --- */
.roompanel{
  display:flex;flex-direction:column;gap:8px;align-items:center;text-align:center;
  background:var(--panel);border:2px solid var(--pop);border-radius:14px;
  padding:14px 12px;box-shadow:var(--glow);
}
.rp-label{font-size:10px;letter-spacing:.24em;color:var(--on-soft);font-weight:900}
.rp-code{
  font-family:"Anton",Impact,sans-serif;font-size:clamp(36px,12vw,50px);line-height:1.2;
  letter-spacing:.22em;padding-left:.22em;color:var(--pop);
}
.rp-url{font-size:11.5px;letter-spacing:.04em;color:var(--on);font-weight:700;word-break:break-all}
.rp-note{font-size:11px;line-height:1.7;color:var(--on-soft);font-weight:500}
.rp-row{display:flex;gap:14px;align-items:center}
.rp-joined{font-size:11px;letter-spacing:.1em;color:var(--on-soft);font-weight:700;line-height:1.7}
.rp-joined b{color:var(--pop);font-family:"Anton",sans-serif;font-size:15px}

/* --- own-device play: roles, lobby, away --- */
.rolebanner{
  display:flex;align-items:center;justify-content:center;gap:9px;flex-wrap:wrap;
  border-radius:10px;padding:9px 12px;text-align:center;
  font-size:11px;letter-spacing:.16em;font-weight:900;
  background:var(--panel);border:1px solid var(--on-line);color:var(--on-soft);
}
.rolebanner b{color:var(--on);font-size:13.5px;letter-spacing:.08em}
.rolebanner.mine{background:linear-gradient(180deg,var(--pop),var(--pop-2));color:var(--pop-ink);border-color:transparent}
.rolebanner.mine b{color:var(--pop-ink)}
.guessview{
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;
  min-height:min(44dvh,320px);border-radius:16px;text-align:center;
  background:var(--panel);border:2px dashed var(--on-line);padding:22px 16px;
}
.guessview .big{font-size:clamp(30px,11vw,52px);font-weight:900;line-height:1.1;color:var(--pop)}
.guessview .who{font-size:13px;letter-spacing:.1em;color:var(--on-soft);font-weight:900;line-height:1.8}
.guessview .who b{color:var(--on);font-size:16px}
.seat.away{opacity:.5}
.seat.away .snm{text-decoration:line-through}
.seat .own{color:var(--pop);font-style:normal;font-size:9px;vertical-align:middle}
.seat .you{
  font-style:normal;font-size:9px;letter-spacing:.1em;background:var(--pop);color:var(--pop-ink);
  border-radius:4px;padding:1px 5px;margin-left:4px;vertical-align:middle;
}
.seat button[aria-pressed="true"]{background:var(--pop);color:var(--pop-ink);border-color:var(--pop)}
.joinbox{display:flex;flex-direction:column;gap:10px}
.joinbox input{
  background:transparent;border:2px solid var(--on-line);border-radius:9px;color:var(--on);
  font-family:inherit;font-weight:900;font-size:16px;padding:14px 12px;
}
.joinbox input:focus{outline:0;border-color:var(--pop)}
.joinbox input#joinRoom{font-family:"Anton",sans-serif;letter-spacing:.24em;text-align:center;text-transform:uppercase}
.waitline{text-align:center;font-size:12px;letter-spacing:.08em;color:var(--on-soft);font-weight:700;line-height:1.9}

/* --- the link bar: room code + connection --- */
.netbar{
  display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  font-size:10px;letter-spacing:.14em;font-weight:900;color:var(--on-soft);
  border:1px dashed var(--on-line);border-radius:10px;padding:7px 10px;
}
.netbar .dot{flex:none;width:8px;height:8px;border-radius:50%;background:var(--on-line)}
.netbar.on .dot{background:var(--pop);box-shadow:0 0 8px var(--pop);animation:pulse 1.6s infinite}
.netbar .netmsg{flex:1;min-width:70px}
.netbar input{
  flex:none;width:76px;background:transparent;border:2px solid var(--on-line);border-radius:7px;
  color:var(--on);font-family:"Anton",sans-serif;font-size:14px;letter-spacing:.18em;
  text-align:center;padding:5px 4px;text-transform:uppercase;
}
.netbar input:focus{outline:0;border-color:var(--pop)}
.netbar .linkbtn{font-size:10px;letter-spacing:.1em;padding:4px 2px}

/* buzz flash */
.flash{position:fixed;inset:0;background:var(--flash);opacity:0;pointer-events:none;z-index:40}
.flash.on{animation:fl .36s ease-out}
@keyframes fl{0%{opacity:.75}100%{opacity:0}}

/* ============ responsive ============ */
@media (max-width:420px){
  body{padding:15px 15px calc(20px + env(safe-area-inset-bottom))}
  .app{gap:13px}
  .btn{font-size:17.5px;padding:15px 14px}
  .arow{--bz:66px}
  .arow .btn{font-size:19px}
  .sheet{padding:20px 16px;gap:18px}
  .steps li{font-size:14px;gap:11px;grid-template-columns:26px 1fr}
  .steps li::before{width:26px}
  .seg button{font-size:13px;padding:11px 1px}
  .tally{gap:9px;font-size:10px}
  .tally b{font-size:20px}
  .clock{font-size:34px}
  .breakdown{gap:18px}
  .seam{font-size:9px;padding:6px 9px;gap:6px}
  .team .row .btn{font-size:16px;padding:12px 4px}
}
@media (max-width:340px){
  body{padding:12px 12px calc(16px + env(safe-area-inset-bottom))}
  .arow{--bz:56px}
  .arow .btn{font-size:17px}
  .tally span{display:none}
  .tally b{margin-left:0}
  .pips{display:none}
}
@media (max-height:720px){
  .logo{margin-top:0}
  .plaque{font-size:clamp(42px,13vw,64px);padding:11px 20px 14px}
  .app{gap:12px}
  #menu{gap:14px}
  .card{min-height:min(44dvh,330px)}
  .end{padding-top:1vh}
  .gate{gap:16px}
}
@media (max-height:600px){
  .card{min-height:268px}
  .band{padding:13px 14px 12px}
  .ng li{min-height:34px;font-size:clamp(15px,4.4vw,19px);padding:5px 10px}
  .logo .sub{margin-top:6px}
}
/* phone held sideways: card beside the controls */
@media (orientation:landscape) and (max-height:560px){
  body{padding:8px 12px calc(10px + env(safe-area-inset-bottom))}
  .app{max-width:880px}
  #play{
    display:grid;align-items:start;column-gap:14px;row-gap:8px;
    grid-template-columns:1fr minmax(186px,236px);
    grid-template-areas:"hud hud" "deck actions" "deck hint" "deck stop";
  }
  #play .hud{grid-area:hud}
  #play .deck{grid-area:deck}
  #play .actions{grid-area:actions;--bz:62px}
  #play .hint{grid-area:hint;font-size:10px}
  #play #stopBtn{grid-area:stop}
  .deck::before,.deck::after{display:none}
  .card{min-height:min(76dvh,252px)}
  .arow .btn{font-size:17px;padding:13px 10px}
  .gate{min-height:auto;gap:14px}
  .pick{flex-direction:row}
  .pick .btn{flex:1}
  .pane{min-height:auto}
  .bz-btn{width:min(44vh,220px)}
  .end{padding-top:0}
  .bigscore{font-size:clamp(60px,16vh,110px)}
  .team .pts{font-size:clamp(40px,11vh,64px)}
}
@media (hover:none) and (pointer:coarse){ .hint br + *, .keys{display:none} .hint .keys{display:none} }
@media (prefers-reduced-motion:reduce){*{animation:none !important;transition:none !important}}

/* ============ teams, turns, session ============ */
.tsetup{display:grid;grid-template-columns:1fr;gap:10px}
.tcard{
  display:flex;flex-direction:column;gap:9px;
  background:var(--panel);border:1px solid var(--on-line);border-radius:12px;padding:12px;
}
.tcard .tname{
  background:transparent;border:0;border-bottom:2px solid var(--on-line);color:var(--on);
  font-family:inherit;font-weight:900;font-size:15px;letter-spacing:.1em;padding:5px 2px;width:100%;
}
.tcard .tname:focus{outline:0;border-bottom-color:var(--pop)}
.chips{display:flex;flex-wrap:wrap;gap:6px;min-height:20px}
.chips:empty::before{
  content:attr(data-empty);font-size:11px;color:var(--on-soft);font-weight:500;letter-spacing:.08em;
}
.chip{
  display:inline-flex;align-items:center;gap:6px;
  background:var(--pop);color:var(--pop-ink);border-radius:999px;
  padding:5px 6px 5px 11px;font-size:12.5px;font-weight:900;max-width:100%;
}
.chip span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chip button{
  border:0;background:rgba(0,0,0,.22);color:inherit;cursor:pointer;
  width:19px;height:19px;border-radius:50%;font-size:11px;line-height:1;
  display:grid;place-items:center;flex:none;
}
.addrow{display:flex;gap:6px}
.addrow input{
  flex:1;min-width:0;background:transparent;border:2px solid var(--on-line);border-radius:8px;
  color:var(--on);font-family:inherit;font-weight:700;font-size:14px;padding:11px 10px;
}
.addrow input:focus{outline:0;border-color:var(--pop)}
.addrow input::placeholder{color:var(--on-soft);font-weight:500}
.addrow .btn{flex:none;width:52px;padding:10px 0;font-size:20px;display:grid;place-items:center}
.warn{text-align:center;font-size:11.5px;color:var(--on-soft);letter-spacing:.06em;font-weight:700;min-height:16px}

/* who is up */
.nowplaying{
  display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  font-size:10.5px;letter-spacing:.16em;color:var(--on-soft);font-weight:900;
}
.nowplaying b{color:var(--on);font-size:12px;letter-spacing:.1em}
.nowplaying .tag{
  background:var(--pop);color:var(--pop-ink);border-radius:999px;padding:3px 9px;
  font-size:10px;letter-spacing:.12em;
}

/* ready / hand-off screen */
.ready{display:flex;flex-direction:column;gap:16px;text-align:center;justify-content:center;min-height:calc(100dvh - 90px)}
.rd-round{font-size:11px;letter-spacing:.24em;color:var(--on-soft);font-weight:900}
.rd-round b{font-family:"Anton",sans-serif;font-size:15px;color:var(--on);letter-spacing:.06em}
.rd-card{
  background:var(--card);color:var(--card-ink);border:2px solid var(--card-line);border-radius:16px;
  box-shadow:0 8px 0 var(--drop),var(--glow);padding:24px 18px;
  display:flex;flex-direction:column;gap:8px;
}
.rd-team{font-family:"Anton",sans-serif;font-size:13px;letter-spacing:.2em;color:var(--mark)}
.rd-label{font-size:10.5px;letter-spacing:.2em;color:var(--card-sub);font-weight:900}
.rd-player{font-size:clamp(30px,10vw,46px);font-weight:900;line-height:1.1;text-wrap:balance}
.rd-note{margin:6px 0 0;font-size:12px;line-height:1.7;color:var(--card-sub);font-weight:500}

/* scoreboard */
.board{display:flex;flex-direction:column;gap:6px}
.brow{
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  background:var(--panel);border:1px solid var(--on-line);border-radius:10px;
  padding:10px 13px;font-size:13px;font-weight:900;letter-spacing:.06em;
}
.brow.on{border-color:var(--pop);box-shadow:var(--glow)}
.brow .who{display:flex;flex-direction:column;gap:2px;text-align:left;min-width:0}
.brow .who small{font-size:9.5px;letter-spacing:.12em;color:var(--on-soft);font-weight:700}
.brow .who span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.brow b{font-family:"Anton",sans-serif;font-size:26px;color:var(--pop);letter-spacing:0;font-variant-numeric:tabular-nums}
.addedto{font-size:11.5px;letter-spacing:.12em;color:var(--on-soft);font-weight:900}
.addedto b{color:var(--pop)}

/* winner */
.win-team{font-size:clamp(26px,9vw,40px);font-weight:900;line-height:1.15;text-wrap:balance}
.mvp{
  font-size:11.5px;letter-spacing:.1em;color:var(--on-soft);font-weight:700;line-height:1.9;
  border:1px dashed var(--on-line);border-radius:10px;padding:10px 12px;
}
.mvp b{color:var(--on);font-size:13px}
/* live mirror on the companion screens */
.live{
  display:flex;flex-direction:column;gap:8px;
  border:1px solid var(--on-line);border-radius:12px;padding:11px 12px;background:var(--panel);
}
.live-head{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:10px;letter-spacing:.16em;color:var(--on-soft);font-weight:900}
.live-dot{display:inline-flex;align-items:center;gap:6px;color:var(--pop)}
.live-dot i{width:7px;height:7px;border-radius:50%;background:var(--pop);animation:pulse 1.6s infinite}
@keyframes pulse{50%{opacity:.25}}
.live-now{font-size:15px;font-weight:900;letter-spacing:.04em}
.live-now small{display:block;font-size:10px;letter-spacing:.16em;color:var(--on-soft);margin-top:3px}
.live-clock{font-family:"Anton",Impact,sans-serif;font-size:28px;line-height:1.15;letter-spacing:.02em;font-variant-numeric:tabular-nums}
.live-clock.low{color:var(--hi)}
@media (min-width:460px){ .tsetup{grid-template-columns:1fr 1fr} }
@media (orientation:landscape) and (max-height:560px){
  .ready{min-height:auto;gap:10px}
  .rd-card{padding:14px}
  .rd-player{font-size:clamp(22px,6vh,34px)}
  .tsetup{grid-template-columns:1fr 1fr}
}

/* ---- seating list: 1 2 1 2 around the table ---- */
.tnames{display:grid;grid-template-columns:1fr 1fr;gap:8px;min-width:0}
.tn{display:flex;align-items:center;gap:7px;min-width:0;background:var(--panel);border:1px solid var(--on-line);border-radius:10px;padding:8px 10px}
.tn input{flex:1 1 auto;width:0;min-width:0;background:transparent;border:0;color:var(--on);font-family:inherit;font-weight:900;font-size:13px;letter-spacing:.06em;padding:3px 0}
.tn input:focus{outline:0}
.tnum{
  flex:none;width:22px;height:22px;border-radius:6px;display:grid;place-items:center;
  font-family:"Anton",sans-serif;font-size:12px;line-height:1;
  background:var(--pop);color:var(--pop-ink);
}
.tnum.n2{background:var(--mark);color:#fff}
.seats{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}
.seats:empty::after{
  content:attr(data-empty);display:block;text-align:center;font-size:11.5px;
  color:var(--on-soft);font-weight:500;letter-spacing:.06em;padding:10px 4px;
  border:1px dashed var(--on-line);border-radius:10px;
}
.seat{
  display:flex;align-items:center;gap:7px;
  background:var(--panel);border:1px solid var(--on-line);border-radius:10px;padding:8px 10px;
}
.seat .snm{flex:1;min-width:0;font-size:14px;font-weight:900;letter-spacing:.04em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.seat .sx{font-size:9.5px;letter-spacing:.14em;color:var(--on-soft);font-weight:700;flex:none}
.seat button{
  flex:none;min-width:30px;height:30px;padding:0 6px;border-radius:8px;cursor:pointer;
  border:1px solid var(--on-line);background:transparent;color:var(--on-soft);
  font-size:10px;font-weight:900;letter-spacing:.06em;line-height:1;
  display:grid;place-items:center;
}
.seat button:active{transform:scale(.94)}
.rd-judge{
  display:flex;align-items:center;justify-content:center;gap:7px;flex-wrap:wrap;
  font-size:11px;letter-spacing:.14em;color:var(--card-sub);font-weight:900;margin-top:2px;
}
.rd-judge b{color:var(--card-ink);font-size:14px;letter-spacing:.04em}
.rd-judge .linkbtn{color:var(--mark);font-size:11px;padding:4px}
.jpick{display:flex;flex-wrap:wrap;gap:6px;justify-content:center}
.jpick button{
  border:2px solid var(--card-line);background:transparent;color:var(--card-ink);
  border-radius:999px;padding:7px 12px;font-family:inherit;font-weight:900;font-size:12px;cursor:pointer;
}
.jpick button[aria-pressed="true"]{background:var(--mark);color:#fff;border-color:var(--mark)}

/* ---- hourglass ---- */
.hg{width:34px;height:52px;flex:none;overflow:visible}
.hg-frame{fill:none;stroke:var(--on-line);stroke-width:2.2;stroke-linejoin:round}
.hg-cap{fill:var(--on-soft)}
.hg-sand{fill:var(--pop);transition:y 1s linear,height 1s linear}
.hg-stream{fill:var(--pop);opacity:0;transition:opacity .3s}
.hg.low .hg-sand,.hg.low .hg-stream{fill:var(--hi)}
.hg.low{animation:hgtick .9s infinite}
@keyframes hgtick{0%,100%{transform:rotate(0)}25%{transform:rotate(-3deg)}75%{transform:rotate(3deg)}}
.hg.turned{animation:hgflip .7s cubic-bezier(.3,.7,.2,1)}
@keyframes hgflip{from{transform:rotate(180deg)}to{transform:rotate(0)}}

/* ---- judge screen ---- */
.jcard .card{cursor:default;min-height:auto}
.jcard .ng li{min-height:34px;font-size:clamp(16px,4.6vw,21px)}
.jwait{text-align:center;font-size:12.5px;line-height:1.9;color:var(--on-soft);font-weight:500;padding:18px 6px}
.jrole{
  display:flex;align-items:center;gap:8px;justify-content:center;flex-wrap:wrap;
  font-size:10.5px;letter-spacing:.14em;color:var(--on-soft);font-weight:900;
}
.jrole b{color:var(--on);font-size:13px;letter-spacing:.06em}
</style>

<div class="app">
  <div class="top" id="topbar" hidden>
    <button class="gear" id="gearBtn" type="button" aria-label="settings">⚙</button>
    <div class="lang" role="group" aria-label="interface language">
      <button type="button" data-lang="ja" aria-pressed="true">日本語</button>
      <button type="button" data-lang="en" aria-pressed="false">EN</button>
    </div>
  </div>

  <div class="netbar" id="netbar" hidden>
    <span class="dot"></span>
    <span class="netmsg" id="netMsg"></span>
    <input id="roomIn" type="text" maxlength="8" autocapitalize="characters" autocomplete="off" spellcheck="false" aria-label="room code">
    <button class="linkbtn" id="netCopy" type="button" data-t="copyLink"></button>
  </div>

  <!-- GATE -->
  <section id="gate" class="gate">
    <div class="logo">
      <div class="plaque">タブー</div>
      <div class="sub en">TABOO</div>
    </div>
    <p class="ask" data-t="tagline"></p>
    <div class="pick">
      <button class="btn btn-light" id="gateStart" type="button">
        <span class="big">はじめる</span>
        <span class="small en">START</span>
      </button>
    </div>
    <div class="links">
      <button class="linkbtn" id="gateJoin" type="button">📱 参加する ／ JOIN A GAME</button>
    </div>
  </section>

  <!-- SETTINGS: app level, reachable from every screen -->
  <section id="settings" class="screen" hidden>
    <div class="hud-row">
      <div class="kicker en" data-t="setTitle"></div>
      <button class="linkbtn" id="setBack" type="button" data-t="back"></button>
    </div>
    <div class="field">
      <div class="label" data-t="uiLang"></div>
      <div class="seg" id="segUi">
        <button type="button" data-v="ja" aria-pressed="true">日本語</button>
        <button type="button" data-v="en" aria-pressed="false">ENGLISH</button>
      </div>
    </div>
    <div class="field">
      <div class="label" data-t="theme"></div>
      <div class="skins" id="segSkin">
        <button type="button" data-v="classic"  aria-pressed="true"><i class="sw sw-classic"></i><span>CLASSIC</span></button>
        <button type="button" data-v="neon"     aria-pressed="false"><i class="sw sw-neon"></i><span>NEON</span></button>
        <button type="button" data-v="poison"   aria-pressed="false"><i class="sw sw-poison"></i><span>POISON</span></button>
        <button type="button" data-v="midnight" aria-pressed="false"><i class="sw sw-midnight"></i><span>MIDNIGHT</span></button>
        <button type="button" data-v="washi"    aria-pressed="false"><i class="sw sw-washi"></i><span>WASHI</span></button>
      </div>
    </div>
    <div class="field">
      <div class="label" data-t="soundLabel"></div>
      <div class="setrow">
        <button class="btn btn-ghost" id="soundBtn" type="button" style="flex:1">SOUND ON</button>
      </div>
    </div>
    <div class="aside" data-t="setNote"></div>
  </section>

  <!-- MENU -->
  <section id="menu" class="screen" hidden>
    <div class="logo">
      <div class="plaque">タブー</div>
      <div class="sub en">TABOO</div>
    </div>
    <p class="tagline" data-t="tagline"></p>
    <div class="field">
      <div class="label" data-t="deckLang"></div>
      <div class="seg" id="segDeck">
        <button type="button" data-v="ja" aria-pressed="true">日本語</button>
        <button type="button" data-v="en" aria-pressed="false">ENGLISH</button>
      </div>
    </div>
    <div class="field">
      <div class="label" data-t="lvl"></div>
      <div class="seg" id="segLevel">
        <button type="button" data-v="0" aria-pressed="true" data-t="lvlAll"></button>
        <button type="button" data-v="1" aria-pressed="false" data-t="lvl1"></button>
        <button type="button" data-v="2" aria-pressed="false" data-t="lvl2"></button>
        <button type="button" data-v="3" aria-pressed="false" data-t="lvl3"></button>
      </div>
    </div>
    <div class="field">
      <div class="label" data-t="time"></div>
      <div class="seg" id="segTime">
        <button type="button" data-v="60" aria-pressed="true">60</button>
        <button type="button" data-v="90" aria-pressed="false">90</button>
        <button type="button" data-v="120" aria-pressed="false">120</button>
      </div>
    </div>
    <button class="btn btn-light" id="teamsBtn" type="button" data-t="hostGame"></button>
    <button class="btn" id="joinBtn" type="button" data-t="joinBtn"></button>
    <button class="btn" id="startBtn" type="button" data-t="quickRound"></button>
    <button class="btn btn-ghost" id="rulesBtn" type="button" data-t="rules"></button>
    <div class="count" id="deckCount"></div>
    <div class="aside" id="netHelp" hidden></div>

  </section>

  <!-- SETUP: players, numbered 1 2 1 2 around the table -->
  <section id="setup" class="screen" hidden>
    <div class="hud-row">
      <div class="kicker en" data-t="setupTitle"></div>
      <button class="linkbtn" id="setupBack" type="button" data-t="back"></button>
    </div>
    <div class="roompanel">
      <div class="rp-label" data-t="roomLabel"></div>
      <div class="rp-code" id="rpCode">----</div>
      <div class="rp-url" id="rpUrl"></div>
      <div class="rp-note" id="rpNote" hidden></div>
      <div class="rp-row">
        <button class="linkbtn" id="rpNew" type="button" data-t="newRoom"></button>
        <button class="linkbtn" id="rpCopy" type="button" data-t="copyLink"></button>
      </div>
      <div class="rp-joined" id="rpJoined"></div>
    </div>
    <p class="pane-hint" data-t="setupHint"></p>
    <div class="tnames">
      <div class="tn"><span class="tnum n1">1</span><input id="tName0" type="text" maxlength="14" aria-label="team 1 name"></div>
      <div class="tn"><span class="tnum n2">2</span><input id="tName1" type="text" maxlength="14" aria-label="team 2 name"></div>
    </div>
    <div class="field">
      <div class="label" data-t="seating"></div>
      <ol class="seats" id="seats"></ol>
      <div class="addrow">
        <input id="pAdd" type="text" maxlength="14" data-ph="addName">
        <button class="btn btn-light" id="pAddBtn" type="button" aria-label="add player">＋</button>
      </div>
    </div>
    <div class="field">
      <div class="label" data-t="laps"></div>
      <div class="seg" id="segLaps">
        <button type="button" data-v="1">1</button>
        <button type="button" data-v="2" aria-pressed="true">2</button>
        <button type="button" data-v="3">3</button>
        <button type="button" data-v="0" data-t="endless"></button>
      </div>
    </div>
    <button class="btn btn-light" id="setupGo" type="button" data-t="setupGo"></button>
    <div class="warn" id="setupWarn"></div>
  </section>

  <!-- JOIN: play from your own phone -->
  <section id="join" class="screen" hidden>
    <div class="hud-row">
      <div class="kicker en" data-t="joinTitle"></div>
      <button class="linkbtn" id="joinBack" type="button" data-t="back"></button>
    </div>
    <p class="pane-hint" data-t="joinHint"></p>
    <div class="joinbox">
      <input id="joinName" type="text" maxlength="14" autocomplete="off" data-ph="joinNamePh">
      <input id="joinRoom" type="text" maxlength="8" autocomplete="off" spellcheck="false" data-ph="joinRoomPh">
      <button class="btn btn-light" id="joinGo" type="button" data-t="joinGo"></button>
    </div>
    <div class="warn" id="joinStatus"></div>
  </section>

  <!-- LOBBY: joined, waiting for the game -->
  <section id="lobby" class="screen" hidden>
    <div class="hud-row">
      <div class="kicker en" data-t="lobbyTitle"></div>
      <button class="linkbtn" id="lobbyLeave" type="button" data-t="leaveGame"></button>
    </div>
    <ol class="seats" id="lobbyList"></ol>
    <div class="waitline" id="lobbyWait"></div>
    <div class="aside" data-t="afkHint"></div>
  </section>

  <!-- READY: hand-off, who describes and who judges -->
  <section id="ready" class="ready" hidden>
    <div class="rd-round" id="rdRound"></div>
    <div class="rd-card">
      <div class="rd-team" id="rdTeam"></div>
      <div class="rd-label" data-t="describerIs"></div>
      <div class="rd-player" id="rdPlayer"></div>
      <div class="rd-judge">
        <span data-t="judgeIs"></span><b id="rdJudge"></b>
        <button class="linkbtn" id="rdJudgeBtn" type="button" data-t="changeJudge"></button>
      </div>
      <div class="jpick" id="jpick" hidden></div>
      <p class="rd-note" data-t="passPhone"></p>
    </div>
    <div class="board" id="rdBoard"></div>
    <button class="btn btn-light" id="rdGo" type="button" data-t="startTurn"></button>
    <div class="waitline" id="rdWait" hidden></div>
    <button class="linkbtn" id="rdSkip" type="button" data-t="skipPlayer"></button>
    <button class="linkbtn" id="rdQuit" type="button" data-t="quitSession"></button>
  </section>

  <!-- RULES -->
  <section id="rules" class="screen" hidden>
    <div class="sheet">
      <div class="sheet-head">
        <div class="kicker en">HOW TO PLAY</div>
        <h2 data-t="rulesTitle"></h2>
      </div>
      <ol class="steps" id="steps"></ol>
      <div class="scoreblock">
        <div class="kicker" data-t="scoreTitle"></div>
        <div class="scoring" id="scoring"></div>
      </div>
      <p class="note" data-t="note"></p>
    </div>
    <button class="btn btn-ghost" id="backBtn" type="button" data-t="back"></button>
  </section>

  <!-- PLAY -->
  <section id="play" class="screen" hidden>
    <div class="hud">
      <div class="nowplaying" id="nowPlaying" hidden></div>
      <div class="hud-row">
        <div class="clock" id="clock">1:00</div>
        <svg class="hg" id="hg" viewBox="0 0 44 68" aria-hidden="true">
          <defs>
            <clipPath id="hgClipTop"><path d="M6 8 H38 L22 32 Z"/></clipPath>
            <clipPath id="hgClipBot"><path d="M22 36 L38 60 H6 Z"/></clipPath>
          </defs>
          <rect class="hg-sand" id="hgTop" x="6" y="8" width="32" height="24" clip-path="url(#hgClipTop)"/>
          <rect class="hg-sand" id="hgBot" x="6" y="60" width="32" height="0" clip-path="url(#hgClipBot)"/>
          <rect class="hg-stream" id="hgStream" x="21.3" y="31" width="1.4" height="27"/>
          <path class="hg-frame" d="M6 8 H38 L22 32 Z"/>
          <path class="hg-frame" d="M22 36 L38 60 H6 Z"/>
          <rect class="hg-cap" x="4" y="4.6" width="36" height="3.4" rx="1.7"/>
          <rect class="hg-cap" x="4" y="60" width="36" height="3.4" rx="1.7"/>
        </svg>
        <div class="tally">
          <span data-t="ok"></span><b id="score">0</b>
          <span data-t="pass"></span><b id="passes">0</b>
          <span data-t="buzz"></span><b id="fouls">0</b>
        </div>
      </div>
    </div>

    <div class="rolebanner" id="roleBanner" hidden></div>

    <div class="guessview" id="guessView" hidden>
      <div class="big" data-t="guessNow"></div>
      <div class="who" id="guessWho"></div>
    </div>

    <div class="deck" id="deckWrap">
      <article class="card" id="card">
        <div class="side side-a">
          <div class="band">
            <button class="turn" id="turnBtn" type="button" aria-label="turn card">⟳</button>
            <div class="reading" id="reading"></div>
            <h2 class="target" id="target"></h2>
          </div>
          <ul class="ng" id="ngList"></ul>
        </div>
        <div class="seam">
          <span class="no" id="cardNo">NO.000</span>
          <span class="pips" id="pips" aria-hidden="true"></span>
          <span class="meta" id="cardMeta"></span>
        </div>
        <div class="side side-b" aria-hidden="true">
          <div class="band">
            <div class="reading" id="reading2"></div>
            <h2 class="target" id="target2"></h2>
          </div>
          <ul class="ng" id="ngList2"></ul>
        </div>
      </article>
    </div>

    <div class="actions">
      <div class="arow">
        <button class="btn" id="okBtn" type="button" data-t="okBtn"></button>
        <button class="buzzer" id="buzzBtn" type="button" aria-label="buzz"><i id="buzzFace"></i></button>
      </div>
      <button class="btn btn-ghost" id="passBtn" type="button" data-t="passBtn"></button>
    </div>
    <div class="hint" id="hint" data-t="hint"></div>
    <button class="linkbtn" id="stopBtn" type="button" style="align-self:center" data-t="stop"></button>
  </section>

  <!-- TURN RESULT -->
  <section id="end" hidden class="end">
    <div>
      <div class="label" data-t="final"></div>
      <p class="bigscore" id="finalScore">0</p>
    </div>
    <div class="breakdown">
      <div><span data-t="ok"></span><b id="fOk">0</b></div>
      <div><span data-t="pass"></span><b id="fPass">0</b></div>
      <div><span data-t="buzz"></span><b id="fBuzz">0</b></div>
    </div>
    <div class="addedto" id="addedTo" hidden></div>
    <div class="board" id="endBoard" hidden></div>
    <div class="missed" id="missed" hidden></div>
    <button class="btn btn-light" id="againBtn" type="button"></button>
  </section>

  <!-- SESSION RESULT -->
  <section id="final" class="screen" hidden style="text-align:center;gap:16px">
    <div class="label" data-t="winnerLabel"></div>
    <div class="win-team" id="winTeam"></div>
    <p class="bigscore" id="winScore" style="font-size:clamp(64px,22vw,110px)">0</p>
    <div class="board" id="finBoard"></div>
    <div class="mvp" id="mvp"></div>
    <button class="btn btn-light" id="finAgain" type="button" data-t="rematch"></button>
    <button class="btn btn-ghost" id="finEdit" type="button" data-t="editTeams"></button>
    <button class="linkbtn" id="finHome" type="button" data-t="toMenu"></button>
  </section>

  <!-- COMPANION: BUZZER -->
  <section id="buzzer" class="pane" hidden>
    <div class="hud-row">
      <div class="kicker en" data-t="bzTitle"></div>
      <button class="linkbtn" id="bzBack" type="button" data-t="bzBack"></button>
    </div>
    <div class="live" id="bzLive" hidden></div>
    <p class="pane-hint" data-t="bzHint"></p>
    <div class="pad">
      <button class="bz-btn" id="bzBtn" type="button"><span id="bzFace"></span></button>
    </div>
    <div class="pane-foot">
      <div class="counter"><span data-t="bzCount"></span><b id="bzCount">0</b></div>
      <button class="linkbtn" id="bzReset" type="button" data-t="bzReset"></button>
    </div>
    <div class="aside" id="bzSync"></div>
  </section>

  <!-- COMPANION: JUDGE (sees the same card as the player) -->
  <section id="judge" class="pane" hidden>
    <div class="hud-row">
      <div class="kicker en" data-t="jgTitle"></div>
      <button class="linkbtn" id="jgBack" type="button" data-t="bzBack"></button>
    </div>
    <div class="live" id="jgLive" hidden></div>
    <div class="jcard" id="jgCard"></div>
    <div class="jwait" id="jgWait"></div>
    <div class="actions" id="jgActions" hidden>
      <div class="arow">
        <button class="btn" id="jgOk" type="button" data-t="okBtn"></button>
        <button class="buzzer" id="jgBuzz" type="button" aria-label="buzz"><i id="jgBuzzFace"></i></button>
      </div>
    </div>
    <div class="aside" id="jgNote"></div>
  </section>

  <!-- COMPANION: SCOREKEEPER -->
  <section id="keeper" class="pane" hidden>
    <div class="hud-row">
      <div class="kicker en" data-t="skTitle"></div>
      <button class="linkbtn" id="skBack" type="button" data-t="skBack"></button>
    </div>
    <div class="live" id="skLive" hidden></div>
    <p class="pane-hint" data-t="skHint"></p>
    <div class="aside" id="skPending" hidden></div>
    <div class="teams">
      <div class="team">
        <input id="skNameA" type="text" maxlength="12" aria-label="team A name">
        <div class="pts" id="skPtsA">0</div>
        <div class="row">
          <button class="btn btn-light" type="button" data-team="a" data-d="1">＋1</button>
          <button class="btn btn-ghost" type="button" data-team="a" data-d="-1">−1</button>
        </div>
      </div>
      <div class="team">
        <input id="skNameB" type="text" maxlength="12" aria-label="team B name">
        <div class="pts" id="skPtsB">0</div>
        <div class="row">
          <button class="btn btn-light" type="button" data-team="b" data-d="1">＋1</button>
          <button class="btn btn-ghost" type="button" data-team="b" data-d="-1">−1</button>
        </div>
      </div>
    </div>
    <div class="pane-foot">
      <button class="linkbtn" id="skUndo" type="button" data-t="skUndo"></button>
      <button class="linkbtn" id="skReset" type="button" data-t="skReset"></button>
    </div>
    <div class="sk-note" data-t="skSaved"></div>
  </section>
</div>
<div class="flash" id="flash" aria-hidden="true"></div>
<div class="buzzask" id="askBuzz" hidden>
  <div class="askcard" role="dialog" aria-modal="true">
    <div class="asktitle" data-t="sureTitle"></div>
    <p class="askbody" data-t="sureBody"></p>
    <div class="askrow">
      <button class="btn btn-light" id="askYes" type="button" data-t="sureYes"></button>
      <button class="btn btn-ghost" id="askNo" type="button" data-t="sureNo"></button>
    </div>
  </div>
</div>

<script>
const DECK_JA = [
{w:"寿司",r:"すし",d:1,c:"食べ物",ng:["ごはん","魚","生","回転","わさび"]},
{w:"ラーメン",r:"",d:1,c:"食べ物",ng:["麺","スープ","しょうゆ","どんぶり","替え玉"]},
{w:"たこ焼き",r:"たこやき",d:1,c:"食べ物",ng:["大阪","タコ","丸い","ソース","粉"]},
{w:"カレー",r:"",d:1,c:"食べ物",ng:["ごはん","辛い","インド","ルー","福神漬け"]},
{w:"味噌汁",r:"みそしる",d:1,c:"食べ物",ng:["みそ","だし","わかめ","豆腐","朝ごはん"]},
{w:"アイスクリーム",r:"",d:1,c:"食べ物",ng:["冷たい","甘い","バニラ","とける","コーン"]},
{w:"納豆",r:"なっとう",d:1,c:"食べ物",ng:["大豆","くさい","ねばねば","発酵","ごはん"]},
{w:"卵焼き",r:"たまごやき",d:1,c:"食べ物",ng:["たまご","お弁当","甘い","フライパン","巻く"]},
{w:"うどん",r:"",d:1,c:"食べ物",ng:["麺","太い","讃岐","つゆ","そば"]},
{w:"焼肉",r:"やきにく",d:1,c:"食べ物",ng:["肉","網","タレ","韓国","焼く"]},
{w:"おにぎり",r:"",d:1,c:"食べ物",ng:["ごはん","三角","のり","梅","コンビニ"]},
{w:"天ぷら",r:"てんぷら",d:1,c:"食べ物",ng:["揚げる","衣","えび","油","そば"]},
{w:"とんかつ",r:"",d:1,c:"食べ物",ng:["豚","揚げる","ソース","キャベツ","衣"]},
{w:"餃子",r:"ぎょうざ",d:1,c:"食べ物",ng:["中華","皮","にんにく","焼く","ひき肉"]},
{w:"チョコレート",r:"",d:1,c:"食べ物",ng:["甘い","茶色","カカオ","バレンタイン","とける"]},
{w:"ケーキ",r:"",d:1,c:"食べ物",ng:["甘い","誕生日","いちご","クリーム","切る"]},
{w:"ピザ",r:"",d:1,c:"食べ物",ng:["チーズ","イタリア","宅配","丸い","生地"]},
{w:"ハンバーガー",r:"",d:1,c:"食べ物",ng:["パン","肉","マクドナルド","セット","ポテト"]},
{w:"コーヒー",r:"",d:1,c:"食べ物",ng:["苦い","朝","カフェイン","豆","カップ"]},
{w:"お茶",r:"おちゃ",d:1,c:"食べ物",ng:["緑","急須","湯のみ","飲む","葉"]},
{w:"ビール",r:"",d:1,c:"食べ物",ng:["泡","苦い","居酒屋","乾杯","生"]},
{w:"スイカ",r:"",d:1,c:"食べ物",ng:["夏","赤","種","緑","割る"]},
{w:"バナナ",r:"",d:1,c:"食べ物",ng:["黄色","皮","むく","猿","長い"]},
{w:"いちご",r:"",d:1,c:"食べ物",ng:["赤","甘い","ケーキ","つぶつぶ","冬"]},
{w:"りんご",r:"",d:1,c:"食べ物",ng:["赤","青森","かじる","皮","果物"]},
{w:"みかん",r:"",d:1,c:"食べ物",ng:["オレンジ","こたつ","皮","冬","むく"]},
{w:"パン",r:"",d:1,c:"食べ物",ng:["焼く","小麦","食パン","バター","朝"]},
