en:{
  tagline:"Describe the word without saying the five words below it.<br>Say one and you get buzzed.",
  deckLang:"CARD LANGUAGE — THE HOST'S CHOICE", theme:"THEME",
  lvl:"LEVEL", lvlAll:"ALL", lvl1:"EASY", lvl2:"MEDIUM", lvl3:"HARD",
